:where(.neo-theme-neo-dark) {
  --portal-examples-list-edge: color-mix(in srgb, var(--sem-color-text-neutral-default) 9%, transparent);
  --portal-examples-list-gradient-start: color-mix(in srgb, var(--portal-headline-primary) 25%, var(--sem-color-bg-neutral-default));
  --portal-examples-list-gradient-end: color-mix(in srgb, var(--sem-color-bg-neutral-default) 89%, var(--portal-headline-primary));
  --portal-examples-list-link-hover: var(--portal-headline-primary);
  --portal-examples-list-surface: var(--sem-color-bg-neutral-default);
  --portal-examples-list-text: var(--sem-color-text-neutral-default);
}