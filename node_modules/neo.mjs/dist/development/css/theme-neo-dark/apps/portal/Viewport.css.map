:where(.neo-theme-neo-dark) {
  --portal-bg-main: var(--sem-color-bg-neutral-default);
  --portal-glass-card-background: rgba(0, 0, 0, 0.6);
  --portal-glass-card-border: 1px solid var(--sem-color-border-subtle);
  --portal-glass-card-hover-border: var(--sem-color-border-focus);
  --portal-glass-card-hover-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  --portal-glass-card-link-color: var(--sem-color-text-primary-default);
  --portal-glass-card-link-hover-color: var(--sem-color-fg-primary-highlighted);
  --portal-glass-card-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  --portal-glass-card-text-opacity: 0.85;
  --portal-headline-primary: var(--sem-color-text-primary-default);
  --portal-scrollbar-thumb: var(--sem-color-surface-primary-default);
  --portal-scrollbar-track: var(--sem-color-bg-neutral-hover);
  --portal-transition-duration: var(--motion-panel);
}