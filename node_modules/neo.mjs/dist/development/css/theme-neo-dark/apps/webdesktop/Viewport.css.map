:root .neo-theme-neo-dark {
  --webdesktop-wallpaper:
      radial-gradient(1100px 760px at 12% 18%, rgba(56, 189, 248, .30), transparent 60%),
      radial-gradient(900px 680px at 88% 12%, rgba(139, 92, 246, .34), transparent 58%),
      radial-gradient(1000px 860px at 72% 96%, rgba(20, 184, 166, .26), transparent 62%),
      linear-gradient(160deg, #0a1020 0%, #10193a 48%, #081325 100%);
  --webdesktop-accent: #60a5fa;
  --webdesktop-focus-ring: 0 0 0 2px rgba(147, 197, 253, .9);
  --webdesktop-glass: rgba(15, 23, 42, .52);
  --webdesktop-glass-active: rgba(255, 255, 255, .14);
  --webdesktop-glass-border: rgba(255, 255, 255, .10);
  --webdesktop-glass-hover: rgba(255, 255, 255, .08);
  --webdesktop-glass-strong: rgba(15, 23, 42, .74);
  --webdesktop-ink: #f1f5f9;
  --webdesktop-ink-dim: rgba(226, 232, 240, .72);
  --webdesktop-ink-faint: rgba(226, 232, 240, .45);
  --webdesktop-label-shadow: 0 1px 2px rgba(2, 6, 23, .65);
  --webdesktop-shadow: 0 30px 80px -20px rgba(2, 6, 23, .70);
  --webdesktop-switch-off: rgba(148, 163, 184, .35);
  --webdesktop-switch-on: #22c55e;
  --menu-list-background-color: rgba(15, 23, 42, .84);
  --menu-list-border-color: rgba(255, 255, 255, .10);
  --menu-list-item-background-color-hover: rgba(255, 255, 255, .08);
  --menu-list-item-color: #f1f5f9;
  --menu-list-item-icon-color: #93c5fd;
  --menu-list-item-icon-gap: .7em;
  --menu-list-item-padding: 8px 12px;
}