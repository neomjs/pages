:root .neo-theme-cyberpunk {
  --carousel-background-color: transparent;
  --carousel-duration: .7s;
  --carousel-inner-background-color: var(--cyber-cyan);
  --carousel-inner-color: transparent;
  --carousel-transition-timing: cubic-bezier(.4, 0, .2, 1);
  --carousel-translate-x: 0;
  --carousel-translate-y: 0;
}