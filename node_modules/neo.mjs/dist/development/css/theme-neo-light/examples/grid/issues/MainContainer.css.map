:where(.neo-theme-neo-light) {
  --examples-grid-issues-area-border: #dcd9e6;
  --examples-grid-issues-area-fg: #4d4960;
  --examples-grid-issues-avatar-fg: #2a2638;
  --examples-grid-issues-avatar-tone: 55% 86%;
  --examples-grid-issues-background: #f5f4f9;
  --examples-grid-issues-border: #e8e6ef;
  --examples-grid-issues-bug-bg: #fdecec;
  --examples-grid-issues-bug-fg: #c4343b;
  --examples-grid-issues-closed-bg: #efe9fe;
  --examples-grid-issues-closed-fg: #6d3fd0;
  --examples-grid-issues-epic-bg: #fff3dc;
  --examples-grid-issues-epic-fg: #a2620a;
  --examples-grid-issues-feature-bg: #e8f0fe;
  --examples-grid-issues-feature-fg: #2f5fc4;
  --examples-grid-issues-hover: #faf9fd;
  --examples-grid-issues-muted-color: #8a869c;
  --examples-grid-issues-neutral-bg: #eef0f3;
  --examples-grid-issues-neutral-fg: #5b6270;
  --examples-grid-issues-open-bg: #e3f6ea;
  --examples-grid-issues-open-fg: #1d7a43;
  --examples-grid-issues-shadow: 0 1px 2px rgba(24, 16, 48, .06), 0 8px 24px rgba(24, 16, 48, .06);
  --examples-grid-issues-surface: #fff;
  --examples-grid-issues-text-color: #5c5870;
  --examples-grid-issues-title-color: #1d1b26;
}