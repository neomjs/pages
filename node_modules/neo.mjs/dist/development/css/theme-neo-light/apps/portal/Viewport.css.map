:where(.neo-theme-neo-light) {
  --portal-bg-main: #fcfcfc;
  --portal-glass-card-background: rgba(255, 255, 255, 0.6);
  --portal-glass-card-border: 1px solid rgba(255, 255, 255, 0.2);
  --portal-glass-card-hover-border: rgba(62, 99, 221, 0.4);
  --portal-glass-card-hover-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  --portal-glass-card-link-color: #3E63DD;
  --portal-glass-card-link-hover-color: #8BA6FF;
  --portal-glass-card-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
  --portal-glass-card-text-opacity: 0.85;
  --portal-headline-primary: #3e63dd;
  --portal-scrollbar-thumb: #3e63dd;
  --portal-scrollbar-track: #f0f0f0;
  --portal-transition-duration: var(--motion-panel);
}