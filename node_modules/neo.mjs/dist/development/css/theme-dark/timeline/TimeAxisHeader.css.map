:where(.neo-theme-dark) {
  --neo-timeline-header-background: var(--grid-header-button-background-image, linear-gradient(#3c3f41, #323232));
  --neo-timeline-header-color: #e0e0e0;
  --neo-timeline-header-muted-color: var(--neo-color);
  --neo-timeline-header-height: 44px;
  --neo-timeline-border-color: var(--grid-container-border-color, #2b2b2b);
  --neo-timeline-tick-border-color: var(--grid-container-border-color, #2b2b2b);
  --neo-timeline-non-working-bg: rgba(0, 0, 0, 0.16);
  --neo-timeline-non-working-border: rgba(0, 0, 0, 0.28);
}