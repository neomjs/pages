.neo-gantt .neo-gantt-link-status {
  position: absolute;
  bottom: 0;
  inset-inline-start: 0;
  max-width: 100%;
  pointer-events: none;
  z-index: 5;
}
.neo-gantt .neo-gantt-link-status:not(:empty) {
  background: var(--sem-color-surface-neutral-default, Canvas);
  border: 1px solid var(--neo-gantt-arrow-color);
  color: var(--sem-color-text-neutral-default, CanvasText);
  padding: 4px 8px;
}
.neo-gantt .neo-timeline-bar.neo-gantt-link-armed {
  outline: 2px solid var(--neo-gantt-arrow-color);
  outline-offset: 2px;
}
.neo-gantt .neo-timeline-bar.neo-gantt-link-target {
  outline: 2px solid var(--neo-gantt-arrow-color);
  outline-offset: 2px;
}
.neo-gantt .neo-timeline-bar.neo-gantt-task-source {
  opacity: 0.25;
}
.neo-gantt .neo-timeline-bar.neo-gantt-task-source .neo-timeline-bar-label {
  visibility: hidden;
}
.neo-gantt .neo-timeline-bar.neo-gantt-linkable {
  overflow: visible;
}
.neo-gantt .neo-gantt-link-terminal {
  background: currentColor;
  border-radius: 50%;
  color: var(--neo-gantt-arrow-color);
  cursor: crosshair;
  height: 10px;
  opacity: 0;
  position: absolute;
  right: -10px;
  top: calc(50% - 5px);
  transform: scale(0.5);
  transition: box-shadow var(--motion-fast) var(--ease-out-soft), opacity var(--motion-fast) var(--ease-out-soft), transform var(--motion-fast) var(--ease-out-soft);
  width: 10px;
  z-index: 3;
}
.neo-gantt .neo-gantt-link-terminal::after {
  content: "";
  inset: -6px -10px -6px 0;
  position: absolute;
}
@media (hover: none) {
  .neo-gantt .neo-gantt-link-terminal {
    opacity: 1;
    transform: scale(1);
  }
}
.neo-gantt .neo-timeline-bar:hover > .neo-gantt-link-terminal,
.neo-gantt .neo-timeline-bar:focus-visible > .neo-gantt-link-terminal,
.neo-gantt .neo-timeline-bar.neo-gantt-link-armed > .neo-gantt-link-terminal {
  opacity: 1;
  transform: scale(1);
}
.neo-gantt .neo-timeline-bar > .neo-gantt-link-terminal:hover {
  box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 35%, transparent);
  transform: scale(1.3);
}
.neo-gantt.neo-gantt-link-drawing .neo-timeline-bar > .neo-gantt-link-terminal {
  opacity: 0;
}
.neo-gantt .neo-grid-header-toolbar {
  align-items: stretch;
  min-height: 56px;
}
.neo-gantt .neo-grid-header-toolbar .neo-grid-header-button {
  height: 100%;
}
.neo-gantt .neo-grid-row .neo-grid-cell.neo-locked-start {
  align-items: center;
  border-right: 1px solid var(--neo-gantt-divider-color);
  display: flex;
  font-weight: 500;
}
.neo-gantt .neo-grid-row .neo-timeline-cell {
  height: 100%;
  padding: 0 !important;
  width: 100%;
}
.neo-gantt .neo-gantt-dependency-layer {
  left: 0;
  overflow: visible;
  pointer-events: none;
  position: absolute;
  top: 0;
  transform: translateX(calc(var(--grid-scroll-left, 0px) * -1));
  z-index: 4;
}
.neo-gantt .neo-gantt-dependency-svg {
  display: block;
  overflow: visible;
  pointer-events: none;
  transform: translateY(-0.5px);
}
.neo-gantt .neo-gantt-dependency-arrow {
  fill: none;
  stroke: var(--neo-gantt-arrow-color);
  stroke-linejoin: round;
  stroke-width: 1.75px;
}
.neo-gantt .neo-gantt-dependency-arrow.neo-gantt-dependency-arrow-highlighted {
  stroke: var(--neo-gantt-highlight-color);
  stroke-width: 2.25px;
}
.neo-gantt .neo-gantt-dependency-arrowhead {
  fill: var(--neo-gantt-arrow-color);
}
.neo-gantt .neo-gantt-dependency-arrowhead.neo-gantt-dependency-arrowhead-highlighted {
  fill: var(--neo-gantt-highlight-color);
}
.neo-gantt .neo-timeline-bar.neo-gantt-bar-summary {
  background: var(--neo-gantt-summary-bg);
  border-color: var(--neo-gantt-summary-border);
  font-weight: 600;
}
.neo-gantt .neo-timeline-bar.neo-gantt-bar-milestone {
  background: var(--neo-gantt-milestone-bg);
  border-color: var(--neo-gantt-milestone-border);
  border-radius: 999px;
}

body:has(.neo-gantt.neo-is-dragging) .neo-gantt.neo-is-dragging .neo-grid-row, body:has(.neo-gantt.neo-is-dragging) .neo-gantt.neo-is-dragging .neo-grid-cell, body:has(.neo-gantt.neo-is-dragging) .neo-gantt.neo-is-dragging .neo-timeline-track, body:has(.neo-gantt.neo-is-dragging) .neo-gantt.neo-is-dragging .neo-timeline-bar {
  pointer-events: auto !important;
}

.neo-gantt-task-proxy {
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.28);
}

.neo-gantt-link-preview {
  border-top: 2px dashed currentColor;
  color: var(--neo-gantt-arrow-color, inherit);
  height: 0;
  pointer-events: none;
  position: fixed;
  transform-origin: left center;
  z-index: 10000;
}
.neo-gantt-link-preview::before {
  background: currentColor;
  border-radius: 50%;
  box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 35%, transparent);
  content: "";
  height: 10px;
  left: -5px;
  position: absolute;
  top: -6px;
  width: 10px;
}
.neo-gantt-link-preview::after {
  border-bottom: 5px solid transparent;
  border-left: 8px solid currentColor;
  border-top: 5px solid transparent;
  content: "";
  position: absolute;
  right: -1px;
  top: -6px;
}