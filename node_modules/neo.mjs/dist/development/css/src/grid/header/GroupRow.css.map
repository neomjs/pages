.neo-grid-header-group-row {
  display: grid;
  grid-template-columns: subgrid;
}
.neo-grid-header-group-row .neo-grid-header-group-part {
  background-color: var(--grid-header-button-background-color);
  background-image: var(--grid-header-button-background-image);
  height: var(--grid-header-group-row-height, 32px);
  min-width: 0;
  overflow: hidden;
  position: relative;
}
.neo-grid-header-group-row .neo-grid-header-group-track {
  height: 100%;
}
.neo-grid-header-group-row .neo-grid-header-group-cell {
  bottom: 0;
  position: absolute;
  top: 0;
}
.neo-grid-header-group-row .neo-grid-header-group-cell.neo-draggable {
  cursor: grab;
}

.neo-grid-header-group-row .neo-grid-header-group-cell {
  align-items: center;
  background-color: var(--grid-header-button-background-color);
  background-image: var(--grid-header-button-background-image);
  border-bottom: 1px solid var(--grid-header-button-border-right-color);
  border-right: 1px solid var(--grid-header-button-border-right-color);
  box-sizing: border-box;
  color: var(--grid-header-button-color);
  display: flex;
  font-size: var(--grid-header-button-font-size);
  font-weight: var(--grid-header-button-font-weight);
  justify-content: center;
  overflow: hidden;
  padding: 0 8px;
  text-overflow: ellipsis;
  user-select: none;
  white-space: nowrap;
}