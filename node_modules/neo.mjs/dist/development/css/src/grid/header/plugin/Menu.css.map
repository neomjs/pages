.neo-grid-menu-wrapper > .neo-grid-menu-trigger {
  --button-text-color: var(--grid-header-button-glyph-color);
  --button-text-color-active: var(--grid-header-button-glyph-color-hover);
  --button-text-color-hover: var(--grid-header-button-glyph-color-hover);
  background: transparent;
  border: 0;
  bottom: 3px;
  height: auto;
  min-width: 20px;
  opacity: 0;
  padding: 0;
  position: absolute;
  right: 6px;
  top: 3px;
  width: 20px;
}
.neo-grid-menu-wrapper:hover > .neo-grid-menu-trigger, .neo-grid-menu-wrapper:focus-within > .neo-grid-menu-trigger,
.neo-grid-menu-wrapper > .neo-grid-column-filtered ~ .neo-grid-menu-trigger {
  opacity: 1;
}

@media (hover: none) {
  .neo-grid-menu-wrapper > .neo-grid-menu-trigger {
    opacity: 1;
  }
}
.neo-grid-column-menu,
.neo-grid-column-menu-hint {
  background-color: var(--grid-header-button-background-color);
  border: 1px solid var(--grid-header-button-border-right-color);
  border-radius: 4px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  padding: 8px;
}
.neo-grid-column-menu .neo-form-field,
.neo-grid-column-menu-hint .neo-form-field {
  margin-bottom: 8px;
}
.neo-grid-column-menu .neo-value-picker,
.neo-grid-column-menu-hint .neo-value-picker {
  --list-item-background-color: transparent;
  background-color: var(--grid-header-button-background-color);
}