.neo-grid-header-wrapper.neo-grid-header-grouped {
  display: grid;
  grid-template-rows: auto auto;
}
.neo-grid-header-wrapper.neo-grid-header-grouped > .neo-grid-header-group-row {
  grid-column: 1/-1;
  grid-row: 1;
}
.neo-grid-header-wrapper.neo-grid-header-grouped > .neo-grid-header-toolbar {
  grid-row: 2;
}