.neo-monthyearselector {
  background-color: var(--dateselector-cell-background-color);
  border: 1px solid var(--dateselector-border-color);
  color: var(--dateselector-cell-color);
  display: flex;
  flex-direction: column;
  font-size: 13px;
  inset: 0;
  position: absolute;
  z-index: 1;
}
.neo-monthyearselector.neo-animated {
  animation: neo-monthyearselector-slide-in 200ms ease-out;
}
.neo-monthyearselector .neo-monthyearselector-lists {
  display: flex;
  flex: 1;
  min-height: 0;
}
.neo-monthyearselector .neo-months,
.neo-monthyearselector .neo-years {
  display: grid;
  flex: 1;
  gap: 2px;
  grid-template-columns: repeat(2, 1fr);
  padding: 4px;
}
.neo-monthyearselector .neo-years-region {
  border-left: 1px solid var(--dateselector-border-color);
  display: flex;
  flex: 1;
  flex-direction: column;
}
.neo-monthyearselector .neo-years-nav {
  display: flex;
  justify-content: space-between;
  padding: 2px 4px 0;
}
.neo-monthyearselector .neo-years-nav-button {
  cursor: pointer;
  padding: 0 4px;
}
.neo-monthyearselector .neo-years-nav-button:before {
  color: var(--dateselector-nav-button-color);
  font-family: var(--fa-style-family-classic);
  font-size: 16px;
  font-weight: 900;
}
.neo-monthyearselector .neo-years-nav-button:hover:before {
  color: var(--dateselector-nav-button-color-hover);
}
.neo-monthyearselector .neo-years-nav-button.neo-disabled {
  cursor: default;
  opacity: 0.3;
  pointer-events: none;
}
.neo-monthyearselector .neo-prev-years:before {
  content: "\f137";
}
.neo-monthyearselector .neo-next-years:before {
  content: "\f138";
}
.neo-monthyearselector .neo-month,
.neo-monthyearselector .neo-year {
  align-items: center;
  border-radius: 4px;
  cursor: pointer;
  display: flex;
  justify-content: center;
}
.neo-monthyearselector .neo-month:hover,
.neo-monthyearselector .neo-year:hover {
  color: var(--dateselector-nav-button-color-hover);
}
.neo-monthyearselector .neo-month:focus,
.neo-monthyearselector .neo-year:focus {
  outline: 0;
}
.neo-monthyearselector .neo-month:focus-visible,
.neo-monthyearselector .neo-year:focus-visible {
  outline: 2px solid var(--dateselector-cell-today-border-color);
  outline-offset: -2px;
}
.neo-monthyearselector .neo-month.neo-selected,
.neo-monthyearselector .neo-year.neo-selected {
  background-color: var(--dateselector-cell-today-border-color);
  color: var(--dateselector-cell-color-selected);
}
.neo-monthyearselector .neo-month.neo-disabled,
.neo-monthyearselector .neo-year.neo-disabled {
  color: var(--dateselector-cell-color-disabled);
  cursor: default;
  pointer-events: none;
}
.neo-monthyearselector .neo-monthyearselector-footer {
  border-top: 1px solid var(--dateselector-border-color);
  display: flex;
  gap: 8px;
  justify-content: center;
  padding: 4px;
}
.neo-monthyearselector .neo-monthyearselector-button {
  border: 1px solid var(--dateselector-border-color);
  border-radius: 4px;
  cursor: pointer;
  padding: 2px 12px;
}
.neo-monthyearselector .neo-monthyearselector-button:hover {
  color: var(--dateselector-nav-button-color-hover);
}

@keyframes neo-monthyearselector-slide-in {
  from {
    transform: translateY(-100%);
  }
  to {
    transform: translateY(0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .neo-monthyearselector.neo-animated {
    animation: none;
  }
}