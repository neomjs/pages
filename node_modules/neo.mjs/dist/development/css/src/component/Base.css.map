.neo-aligned-bottom {
  box-shadow: var(--aligned-bottom-box-shadow);
}

.neo-aligned-left {
  box-shadow: var(--aligned-left-box-shadow);
}

.neo-aligned-right {
  box-shadow: var(--aligned-right-box-shadow);
}

.neo-aligned-top {
  box-shadow: var(--aligned-top-box-shadow);
}

.neo-floating {
  background-color: var(--neo-background-color);
  left: -10000px;
  position: fixed;
  top: -10000px;
  z-index: 1000;
}

.neo-masked, .neo-store-loading {
  position: relative;
}
.neo-masked .neo-load-mask, .neo-masked .neo-store-load-mask, .neo-store-loading .neo-load-mask, .neo-store-loading .neo-store-load-mask {
  align-content: center;
  background-color: inherit;
  border-radius: inherit;
  display: grid;
  inset: 0;
  justify-content: center;
  overflow: clip;
  position: absolute;
  z-index: 4;
}
.neo-masked .neo-load-mask .neo-load-mask-body, .neo-masked .neo-store-load-mask .neo-load-mask-body, .neo-store-loading .neo-load-mask .neo-load-mask-body, .neo-store-loading .neo-store-load-mask .neo-load-mask-body {
  align-items: center;
  display: flex;
  flex-flow: row nowrap;
  gap: 0.7em;
}
.neo-masked .neo-load-mask .neo-load-mask-body .fa-spinner, .neo-masked .neo-store-load-mask .neo-load-mask-body .fa-spinner, .neo-store-loading .neo-load-mask .neo-load-mask-body .fa-spinner, .neo-store-loading .neo-store-load-mask .neo-load-mask-body .fa-spinner {
  height: 1em;
  width: 1em;
}
.neo-masked .neo-load-mask .neo-load-mask-body .neo-loading-message, .neo-masked .neo-store-load-mask .neo-load-mask-body .neo-loading-message, .neo-store-loading .neo-load-mask .neo-load-mask-body .neo-loading-message, .neo-store-loading .neo-store-load-mask .neo-load-mask-body .neo-loading-message {
  color: inherit;
}

.neo-store-loading-with-items .neo-store-load-mask {
  background-color: transparent;
  inset: auto 0.75em 0.75em auto;
  pointer-events: none;
}

.neo-store-load-mask .neo-load-mask-body {
  background-color: var(--neo-background-color);
  border-radius: 50%;
  color: var(--neo-color);
  padding: 0.5em;
}