.neo-carousel {
  background: var(--carousel-background-color);
  height: 14rem;
  padding: 15px;
}
.neo-carousel .neo-carousel-btn-bar {
  text-align: end;
}
.neo-carousel .neo-carousel-btn-bar .neo-carousel-btn {
  font-size: 18px;
  padding: 15px;
}
.neo-carousel .neo-carousel-inner {
  background-color: var(--carousel-inner-background-color);
  border-radius: 5px;
  color: var(--carousel-inner-color);
  height: 9rem;
  overflow: hidden;
  position: relative;
}
.neo-carousel .neo-carousel-inner:before {
  content: "";
  position: absolute;
  background: linear-gradient(90deg, var(--carousel-inner-background-color) 0%, var(--carousel-inner-background-color) 50%, rgba(0, 0, 0, 0) 100%);
  top: 0;
  bottom: 0;
  left: 0;
  width: 30px;
  z-index: 11;
}
.neo-carousel .neo-carousel-inner:after {
  content: "";
  position: absolute;
  background: linear-gradient(270deg, var(--carousel-inner-background-color) 0%, var(--carousel-inner-background-color) 50%, rgba(0, 0, 0, 0) 100%);
  top: 0;
  bottom: 0;
  right: 0;
  width: 30px;
  z-index: 11;
}
.neo-carousel .neo-carousel-inner .neo-carousel-item {
  height: 9rem;
  inset: 0;
  padding: 15px;
  position: absolute;
  text-align: center;
  transform: translate(var(--carousel-translate-x), var(--carousel-translate-y));
  transition-duration: var(--carousel-duration);
  transition-property: all;
  transition-timing-function: var(--carousel-transition-timing);
  z-index: 10;
}

.neo-carousel--translate-x-full {
  --carousel-translate-x: -100%;
  transform: translate(var(--carousel-translate-x), var(--carousel-translate-y));
}

.neo-carousel-translate-x-0 {
  --carousel-translate-x: 0;
  transform: translate(var(--carousel-translate-x), var(--carousel-translate-y));
}

.neo-carousel-translate-x-full {
  --carousel-translate-x: 100%;
  transform: translate(var(--carousel-translate-x), var(--carousel-translate-y));
}