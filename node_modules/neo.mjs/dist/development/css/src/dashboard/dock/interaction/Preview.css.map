@keyframes neo-dock-preview-dwell-fill {
  from {
    transform: scaleY(0);
  }
  to {
    transform: scaleY(1);
  }
}
.neo-dock-preview {
  inset: 0;
  pointer-events: none;
  position: absolute;
  z-index: 25;
}
.neo-dock-preview .neo-dock-preview-affordance {
  border-radius: 3px;
  box-sizing: border-box;
  opacity: 0.85;
  pointer-events: none;
  position: absolute;
  transition: opacity var(--dock-transition-duration) var(--dock-transition-easing), background-color var(--dock-transition-duration) var(--dock-transition-easing), border-color var(--dock-transition-duration) var(--dock-transition-easing);
}
.neo-dock-preview .neo-dock-preview-dwelling {
  overflow: hidden;
}
.neo-dock-preview .neo-dock-preview-dwelling::after {
  animation: neo-dock-preview-dwell-fill var(--dock-native-dwell-ms, 1200ms) linear calc(-1 * var(--dock-native-dwell-elapsed, 0ms)) 1 forwards;
  background-color: var(--agent-dock-preview-accept, #58a6ff);
  content: "";
  inset: 0;
  opacity: 0.35;
  pointer-events: none;
  position: absolute;
  transform: scaleY(0);
  transform-origin: bottom;
}
.neo-dock-preview .neo-dock-preview-edge.neo-dock-preview-accepted,
.neo-dock-preview .neo-dock-preview-region.neo-dock-preview-accepted,
.neo-dock-preview .neo-dock-preview-tab-into.neo-dock-preview-accepted {
  background-color: var(--agent-dock-preview-accept-fill, rgba(88, 166, 255, 0.22));
  border: 2px solid var(--agent-dock-preview-accept, #58a6ff);
}
.neo-dock-preview .neo-dock-preview-edge.neo-dock-preview-rejected,
.neo-dock-preview .neo-dock-preview-region.neo-dock-preview-rejected,
.neo-dock-preview .neo-dock-preview-tab-into.neo-dock-preview-rejected {
  background-color: var(--agent-dock-preview-reject-fill, rgba(207, 34, 46, 0.16));
  border: 2px dashed var(--agent-dock-preview-reject, #cf222e);
  opacity: 0.55;
}
.neo-dock-preview .neo-dock-preview-split:not(.neo-dock-preview-region),
.neo-dock-preview .neo-dock-preview-tab-before,
.neo-dock-preview .neo-dock-preview-tab-after {
  border-radius: 2px;
}
.neo-dock-preview .neo-dock-preview-split:not(.neo-dock-preview-region).neo-dock-preview-accepted,
.neo-dock-preview .neo-dock-preview-tab-before.neo-dock-preview-accepted,
.neo-dock-preview .neo-dock-preview-tab-after.neo-dock-preview-accepted {
  background-color: var(--agent-dock-preview-accept, #58a6ff);
  box-shadow: 0 0 6px var(--agent-dock-preview-accept, #58a6ff);
}
.neo-dock-preview .neo-dock-preview-split:not(.neo-dock-preview-region).neo-dock-preview-rejected,
.neo-dock-preview .neo-dock-preview-tab-before.neo-dock-preview-rejected,
.neo-dock-preview .neo-dock-preview-tab-after.neo-dock-preview-rejected {
  background-color: var(--agent-dock-preview-reject, #cf222e);
  opacity: 0.55;
}

@media (prefers-reduced-motion: reduce) {
  .neo-dock-preview .neo-dock-preview-dwelling::after {
    animation: none;
    opacity: 0.2;
    transform: scaleY(1);
  }
}
.neo-preview-lang-signal .neo-dock-preview .neo-dock-preview-edge.neo-dock-preview-accepted,
.neo-preview-lang-signal .neo-dock-preview .neo-dock-preview-region.neo-dock-preview-accepted,
.neo-preview-lang-signal .neo-dock-preview .neo-dock-preview-tab-into.neo-dock-preview-accepted {
  background-color: var(--agent-dock-preview-signal-fill);
  border-color: var(--agent-dock-preview-signal);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--agent-dock-preview-signal) 55%, transparent), 0 0 14px color-mix(in srgb, var(--agent-dock-preview-signal) 25%, transparent);
}
.neo-preview-lang-signal .neo-dock-preview .neo-dock-preview-split:not(.neo-dock-preview-region).neo-dock-preview-accepted,
.neo-preview-lang-signal .neo-dock-preview .neo-dock-preview-tab-before.neo-dock-preview-accepted,
.neo-preview-lang-signal .neo-dock-preview .neo-dock-preview-tab-after.neo-dock-preview-accepted {
  background-color: var(--agent-dock-preview-signal);
  box-shadow: 0 0 8px color-mix(in srgb, var(--agent-dock-preview-signal) 60%, transparent);
}