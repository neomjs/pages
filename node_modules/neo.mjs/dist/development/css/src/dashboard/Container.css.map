  visibility: hidden;
}

.neo-dashboard-dock-drop-indicator-center::before {
  border: 2px solid var(--agent-dock-preview-accept, #4493f8);
  border-radius: 3px;
  height: 10px;
  width: 10px;
}
.neo-dashboard-dock-drop-indicator-top::before {
  transform: rotate(-135deg) translate(-1px, -1px);
}
.neo-dashboard-dock-drop-indicator-right::before {
  transform: rotate(-45deg) translate(-1px, 1px);
}
.neo-dashboard-dock-drop-indicator-bottom::before {
  transform: rotate(45deg) translate(-1px, -1px);
}
.neo-dashboard-dock-drop-indicator-left::before {
  transform: rotate(135deg) translate(-1px, 1px);
}

.neo-dashboard-dock-drop-chip-top::before {
  transform: rotate(-135deg) translate(-1px, -1px);
}
.neo-dashboard-dock-drop-chip-right::before {
  transform: rotate(-45deg) translate(-1px, 1px);
}
.neo-dashboard-dock-drop-chip-bottom::before {
  transform: rotate(45deg) translate(-1px, -1px);
}
.neo-dashboard-dock-drop-chip-left::before {
  transform: rotate(135deg) translate(-1px, 1px);
}

