.neo-dashboard-dock-drop-indicator,
.neo-dashboard-dock-drop-chip {
  align-items: center;
  background: var(--dock-preview-ground, rgba(28, 33, 40, 0.92));
  border: 1px solid var(--dock-preview-line, rgba(139, 148, 158, 0.45));
  border-radius: 6px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  display: flex;
  justify-content: center;
  opacity: 0.92;
  position: absolute;
  transition: left var(--dock-transition-duration-fast) var(--dock-transition-easing), top var(--dock-transition-duration-fast) var(--dock-transition-easing), opacity var(--dock-transition-duration-fast) var(--dock-transition-easing), border-color var(--dock-transition-duration-fast) var(--dock-transition-easing), background var(--dock-transition-duration-fast) var(--dock-transition-easing);
}
.neo-dashboard-dock-drop-indicator::before,
.neo-dashboard-dock-drop-chip::before {
  border-color: var(--agent-dock-preview-accept, #4493f8);
  border-style: solid;
  border-width: 0 2px 2px 0;
  content: "";
  height: 7px;
  width: 7px;
}
.neo-dashboard-dock-drop-indicator-active,
.neo-dashboard-dock-drop-chip-active {
  background: var(--agent-dock-preview-accept-fill, rgba(68, 147, 248, 0.24));
  border-color: var(--agent-dock-preview-accept, #4493f8);
  opacity: 1;
}
