}
.neo-dashboard-dock-reveal-overlay-swap-1.neo-dashboard-dock-reveal-overlay-right > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay-swap-1.neo-dashboard-dock-reveal-overlay-right > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-right-b;
}
.neo-dashboard-dock-reveal-overlay-swap-1.neo-dashboard-dock-reveal-overlay-top > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay-swap-1.neo-dashboard-dock-reveal-overlay-top > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-top-b;
}
.neo-dashboard-dock-reveal-overlay-swap-1.neo-dashboard-dock-reveal-overlay-bottom > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay-swap-1.neo-dashboard-dock-reveal-overlay-bottom > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-bottom-b;
}

.neo-dashboard-dock-reveal-overlay-swap-2 {
  animation-name: neo-dock-reveal-hold-a;
}
.neo-dashboard-dock-reveal-overlay-swap-2 > .neo-dashboard-dock-reveal-header,
.neo-dashboard-dock-reveal-overlay-swap-2 > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-left;
}
.neo-dashboard-dock-reveal-overlay-swap-2.neo-dashboard-dock-reveal-overlay-right > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay-swap-2.neo-dashboard-dock-reveal-overlay-right > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-right;
}
.neo-dashboard-dock-reveal-overlay-swap-2.neo-dashboard-dock-reveal-overlay-top > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay-swap-2.neo-dashboard-dock-reveal-overlay-top > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-top;
}
.neo-dashboard-dock-reveal-overlay-swap-2.neo-dashboard-dock-reveal-overlay-bottom > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay-swap-2.neo-dashboard-dock-reveal-overlay-bottom > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-from-bottom;
}

@keyframes neo-dock-reveal-hold-a {
  to {
    opacity: 1;
  }
}
@keyframes neo-dock-reveal-hold-b {
  to {
    opacity: 1;
  }
}
.neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving {
  animation-fill-mode: forwards;
  animation-name: neo-dock-reveal-fade-out;
  pointer-events: none;
}
.neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving > .neo-dashboard-dock-reveal-header,
.neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving > .neo-dashboard-dock-reveal-pane-slot {
  animation-fill-mode: forwards;
  animation-name: neo-dock-reveal-to-left;
}
.neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving.neo-dashboard-dock-reveal-overlay-right > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving.neo-dashboard-dock-reveal-overlay-right > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-to-right;
}
.neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving.neo-dashboard-dock-reveal-overlay-top > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving.neo-dashboard-dock-reveal-overlay-top > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-to-top;
}
.neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving.neo-dashboard-dock-reveal-overlay-bottom > .neo-dashboard-dock-reveal-header, .neo-dashboard-dock-reveal-overlay.neo-dashboard-dock-reveal-overlay-leaving.neo-dashboard-dock-reveal-overlay-bottom > .neo-dashboard-dock-reveal-pane-slot {
  animation-name: neo-dock-reveal-to-bottom;
}

@keyframes neo-dock-reveal-fade-out {
  to {
    opacity: 0;
  }
}
@keyframes neo-dock-reveal-to-left {
  to {
    transform: translateX(-100cqw);
  }
}
@keyframes neo-dock-reveal-to-right {
  to {
    transform: translateX(100cqw);
  }
