}

.neo-dashboard-dock-arrival {
  animation: neo-dock-arrival-settle calc(var(--dock-transition-duration) * 1.5) var(--dock-transition-easing);
}

@keyframes neo-dock-arrival-settle {
  from {
    outline: 2px solid var(--dock-arrival-outline, rgba(88, 166, 255, 0.55));
    outline-offset: -2px;
  }
  to {
    outline: 2px solid transparent;
    outline-offset: -2px;
  }
}
.neo-dashboard-dock-splitter {
  flex-shrink: 0;
  position: relative;
  touch-action: none;
  z-index: 2;
  background-color: var(--dock-splitter-background);
  border-radius: var(--dock-splitter-radius);
  box-shadow: var(--dock-splitter-ring);
  transition: background-color var(--dock-transition-duration-fast) var(--dock-transition-easing), box-shadow var(--dock-transition-duration-fast) var(--dock-transition-easing);
}
.neo-dashboard-dock-splitter::before {
