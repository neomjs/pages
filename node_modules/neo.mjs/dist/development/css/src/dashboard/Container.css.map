  background: var(--agent-dock-preview-signal-fill);
  border-color: var(--agent-dock-preview-signal);
  box-shadow: 0 2px 12px color-mix(in srgb, var(--agent-dock-preview-signal) 30%, transparent);
}
.neo-preview-lang-signal .neo-dashboard-dock-drop-indicator-center::before {
  border-color: var(--agent-dock-preview-signal);
}

body > .neo-dock-dragproxy.neo-tab-header-toolbar {
  --tab-button-glyph-color: var(--agent-dock-proxy-text);
  --tab-button-text-color: var(--agent-dock-proxy-text);
  background: var(--agent-dock-proxy-ground);
  border: 1px solid var(--agent-dock-proxy-border);
  border-radius: 6px;
  box-shadow: 0 10px 28px color-mix(in srgb, var(--agent-dock-proxy-shadow) 58%, transparent);
  box-sizing: border-box;
  color: var(--agent-dock-proxy-text);
  overflow: hidden;
}
body > .neo-dock-dragproxy.neo-tab-header-toolbar.neo-preview-lang-signal {
  box-shadow: 0 0 0 1px var(--agent-dock-preview-signal), 0 4px 14px color-mix(in srgb, var(--agent-dock-preview-signal) 35%, transparent), 0 10px 28px color-mix(in srgb, var(--agent-dock-proxy-shadow) 58%, transparent);
}

@keyframes neo-preview-signal-lock {
  0% {
    opacity: 0.55;
  }
  100% {
    opacity: 1;
  }
}
.neo-dashboard .neo-dock-pane-locked {
  outline: 1px solid color-mix(in srgb, currentColor 34%, transparent);
  outline-offset: -1px;
}

.neo-dashboard .neo-dock-pane-locked[inert] {
  cursor: not-allowed;
}