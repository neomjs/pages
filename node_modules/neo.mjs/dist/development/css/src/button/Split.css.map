.neo-split-button {
  display: flex;
  width: fit-content;
}
.neo-split-button .neo-button {
  margin: 0;
  padding: 0.5em;
}
.neo-split-button .neo-button:active, .neo-split-button .neo-button:hover, .neo-split-button .neo-button.pressed {
  z-index: 1;
}
.neo-split-button .neo-button:first-child:not(:last-child) {
  border-bottom-right-radius: 0;
  border-top-right-radius: 0;
}
.neo-split-button .neo-trigger-button {
  border-bottom-left-radius: 0;
  border-top-left-radius: 0;
  margin-left: calc(-1 * var(--button-border-width));
}