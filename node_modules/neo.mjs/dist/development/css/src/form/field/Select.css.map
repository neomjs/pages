.neo-selectfield {
  display: flex;
  flex-direction: column;
  gap: 0.35em;
}
.neo-selectfield .neo-selectfield-label {
  color: var(--selectfield-color);
}
.neo-selectfield .neo-selectfield-input {
  background: var(--selectfield-background);
  border: 1px solid var(--selectfield-border-color);
  border-radius: 3px;
  color: var(--selectfield-color);
  font: inherit;
  min-height: 32px;
  padding: 0.4em 0.6em;
  width: 100%;
}
.neo-selectfield .neo-selectfield-input:focus-visible {
  outline: 2px solid var(--selectfield-focus-color);
  outline-offset: 2px;
}
.neo-selectfield.neo-selectfield-customizable .neo-selectfield-input,
.neo-selectfield.neo-selectfield-customizable .neo-selectfield-input::picker(select) {
  appearance: base-select;
}
.neo-selectfield .neo-selectfield-error {
  color: var(--selectfield-error-color);
  font-size: 0.85em;
}
.neo-selectfield.neo-invalid .neo-selectfield-input {
  border-color: var(--selectfield-error-color);
}