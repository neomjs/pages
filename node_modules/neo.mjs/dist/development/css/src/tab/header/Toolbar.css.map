.neo-tab-header-toolbar {
  background-color: transparent;
  flex: 0 0 auto;
  padding: 0;
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button {
  align-self: center;
  background-color: transparent;
  background-image: none;
  border: 0;
  border-radius: var(--tab-header-action-border-radius);
  height: var(--tab-header-action-size);
  margin: 0;
  min-width: var(--tab-header-action-size);
  padding: 0;
  width: var(--tab-header-action-size);
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button .neo-button-glyph {
  color: var(--tab-header-action-glyph-color);
  font-size: 12px;
  margin: 0;
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button .neo-button-ripple-wrapper {
  border-radius: inherit;
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button.neo-disabled {
  opacity: var(--neo-disabled-opacity);
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button:hover {
  background-color: var(--tab-header-action-background-color-hover);
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button:hover .neo-button-glyph {
  color: var(--tab-header-action-glyph-color-hover);
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button:active {
  background-color: var(--tab-header-action-background-color-active);
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button:active .neo-button-glyph {
  color: var(--tab-header-action-glyph-color-active);
}
.neo-tab-header-toolbar.neo-toolbar > .neo-toolbar-action.neo-button:focus-visible {
  outline: 2px solid var(--tab-header-action-glyph-color-hover);
  outline-offset: -2px;
}
.neo-tab-header-toolbar.neo-dock-bottom .neo-tab-header-button.neo-button {
  align-self: start;
  background-image: var(--tab-button-background-image-bottom);
}
.neo-tab-header-toolbar.neo-dock-bottom .neo-tab-header-button.neo-button .neo-tab-button-indicator {
  bottom: unset;
  height: var(--tab-strip-height);
  top: calc(var(--tab-strip-height) * -1);
  width: 100%;
}
.neo-tab-header-toolbar.neo-dock-bottom .neo-tab-header-button.neo-button.pressed {
  background-image: var(--tab-button-background-image-pressed-bottom) !important;
}
.neo-tab-header-toolbar.neo-dock-left {
  height: unset;
  width: var(--tab-button-height-pressed);
}
.neo-tab-header-toolbar.neo-dock-left .neo-tab-header-button.neo-button {
  background-image: var(--tab-button-background-image-left);
  height: unset;
  width: var(--tab-button-height);
}
.neo-tab-header-toolbar.neo-dock-left .neo-tab-header-button.neo-button .neo-tab-button-indicator {
  bottom: unset;
  height: 100%;
  right: calc(var(--tab-strip-height) * -1);
  width: var(--tab-strip-height);
}
.neo-tab-header-toolbar.neo-dock-left .neo-tab-header-button.neo-button.pressed {
  background-image: var(--tab-button-background-image-pressed-left) !important;
  width: var(--tab-button-height-pressed);
}
.neo-tab-header-toolbar.neo-dock-left .neo-tab-header-button.neo-button:not(:last-child) {
  margin-right: unset;
  margin-top: var(--tab-button-gap);
}
.neo-tab-header-toolbar.neo-dock-right {
  height: unset;
  width: var(--tab-button-height-pressed);
}
.neo-tab-header-toolbar.neo-dock-right .neo-tab-header-button.neo-button {
  align-self: start;
  background-image: var(--tab-button-background-image-right);
  height: unset;
  width: var(--tab-button-height);
}
.neo-tab-header-toolbar.neo-dock-right .neo-tab-header-button.neo-button .neo-tab-button-indicator {
  bottom: unset;
  height: 100%;
  left: calc(var(--tab-strip-height) * -1);
  width: var(--tab-strip-height);
}
.neo-tab-header-toolbar.neo-dock-right .neo-tab-header-button.neo-button.pressed {
  background-image: var(--tab-button-background-image-pressed-right) !important;
  width: var(--tab-button-height-pressed);
}
.neo-tab-header-toolbar.neo-dock-right .neo-tab-header-button.neo-button:not(:last-child) {
  margin-bottom: var(--tab-button-gap);
  margin-right: unset;
}
.neo-tab-header-toolbar.neo-no-animation .neo-tab-header-button.neo-button .neo-tab-button-indicator {
  animation-duration: 0ms !important;
}

.neo-button.neo-tab-overflow-control {
  margin: 0;
}