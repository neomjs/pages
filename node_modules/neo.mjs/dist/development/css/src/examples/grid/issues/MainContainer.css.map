.neo-theme-neo-dark,
.neo-theme-neo-light {
  --grid-header-button-background-color: var(--examples-grid-issues-surface);
  --grid-header-button-background-color-hover: var(--examples-grid-issues-hover);
  --grid-header-button-border-right-color: var(--examples-grid-issues-border);
  --grid-header-button-color: var(--examples-grid-issues-muted-color);
  --grid-header-button-color-hover: var(--examples-grid-issues-title-color);
  --grid-header-button-font-size: 11px;
  --grid-header-button-font-weight: 700;
  --grid-header-button-glyph-color: var(--examples-grid-issues-muted-color);
  --grid-header-button-glyph-color-hover: var(--examples-grid-issues-title-color);
}

.neo-examples-grid-issues {
  background-color: var(--examples-grid-issues-background);
  color: var(--examples-grid-issues-text-color);
  font-family: var(--neo-font-family);
  padding: 0 20px 20px;
}
.neo-examples-grid-issues .issues-header {
  background-color: transparent;
  gap: 16px;
  padding: 22px 8px 16px;
}
.neo-examples-grid-issues .issues-heading-title {
  color: var(--examples-grid-issues-title-color);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.01em;
}
.neo-examples-grid-issues .issues-heading-subtitle {
  color: var(--examples-grid-issues-muted-color);
  font-size: 13px;
  margin-top: 4px;
}
.neo-examples-grid-issues .issues-toggle {
  color: var(--examples-grid-issues-text-color);
  font-size: 13px;
}
.neo-examples-grid-issues .issues-grid {
  --grid-container-border-color: var(--examples-grid-issues-border);
  --grid-container-cell-background-color: var(--examples-grid-issues-surface);
  --grid-container-cell-background-color-even: var(--examples-grid-issues-surface);
  --grid-container-color: var(--examples-grid-issues-text-color);
  --grid-container-font-size: 14px;
  --grid-cell-background-color-hover: var(--examples-grid-issues-hover);
  background-color: var(--examples-grid-issues-surface);
  border: 1px solid var(--examples-grid-issues-border);
  border-radius: 12px;
  box-shadow: var(--examples-grid-issues-shadow);
  overflow: hidden;
}
.neo-examples-grid-issues .issues-grid .neo-grid-header-toolbar .neo-grid-header-button {
  letter-spacing: 0.06em;
}
.neo-examples-grid-issues .issues-grid .neo-grid-row .neo-grid-cell {
  border-right: none;
  line-height: 1.45;
  padding: 10px 14px;
}
.neo-examples-grid-issues .issues-grid .neo-grid-row .neo-grid-cell.issues-id {
  color: var(--examples-grid-issues-muted-color);
  font-size: 13px;
  font-variant-numeric: tabular-nums;
}
.neo-examples-grid-issues .issues-grid .neo-grid-row .neo-grid-cell.issues-title {
  color: var(--examples-grid-issues-title-color);
  font-weight: 600;
}
.neo-examples-grid-issues .issues-grid .neo-grid-row .neo-grid-cell.issues-summary {
  color: var(--examples-grid-issues-text-color);
  font-size: 13px;
}
.neo-examples-grid-issues .issues-grid .neo-grid-row .neo-grid-cell.issues-date {
  color: var(--examples-grid-issues-muted-color);
  font-size: 13px;
}
.neo-examples-grid-issues .issues-grid.issues-fixed-rows .neo-grid-row .neo-grid-cell.issues-title, .neo-examples-grid-issues .issues-grid.issues-fixed-rows .neo-grid-row .neo-grid-cell.issues-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.neo-examples-grid-issues .issues-chip {
  border-radius: 999px;
  display: inline-flex;
  font-size: 12px;
  font-weight: 600;
  line-height: 20px;
  padding: 0 10px;
  white-space: nowrap;
}
.neo-examples-grid-issues .issues-type-bug {
  background-color: var(--examples-grid-issues-bug-bg);
  color: var(--examples-grid-issues-bug-fg);
}
.neo-examples-grid-issues .issues-type-feature {
  background-color: var(--examples-grid-issues-feature-bg);
  color: var(--examples-grid-issues-feature-fg);
}
.neo-examples-grid-issues .issues-type-epic {
  background-color: var(--examples-grid-issues-epic-bg);
  color: var(--examples-grid-issues-epic-fg);
}
.neo-examples-grid-issues .issues-type-task {
  background-color: var(--examples-grid-issues-neutral-bg);
  color: var(--examples-grid-issues-neutral-fg);
}
.neo-examples-grid-issues .issues-state {
  padding-left: 8px;
}
.neo-examples-grid-issues .issues-state:before {
  background-color: currentColor;
  border-radius: 50%;
  content: "";
  height: 6px;
  margin: 7px 6px 0 0;
  width: 6px;
}
.neo-examples-grid-issues .issues-state-open {
  background-color: var(--examples-grid-issues-open-bg);
  color: var(--examples-grid-issues-open-fg);
}
.neo-examples-grid-issues .issues-state-closed {
  background-color: var(--examples-grid-issues-closed-bg);
  color: var(--examples-grid-issues-closed-fg);
}
.neo-examples-grid-issues .issues-state-not-planned,
.neo-examples-grid-issues .issues-state-duplicate {
  background-color: var(--examples-grid-issues-neutral-bg);
  color: var(--examples-grid-issues-neutral-fg);
}
.neo-examples-grid-issues .issues-area {
  background-color: transparent;
  border: 1px solid var(--examples-grid-issues-area-border);
  color: var(--examples-grid-issues-area-fg);
  font-weight: 500;
}
.neo-examples-grid-issues .issues-author {
  align-items: center;
  display: inline-flex;
  font-size: 13px;
  gap: 8px;
}
.neo-examples-grid-issues .issues-avatar {
  align-items: center;
  background-color: hsl(var(--issues-avatar-hue) var(--examples-grid-issues-avatar-tone));
  border-radius: 50%;
  color: var(--examples-grid-issues-avatar-fg);
  display: inline-flex;
  flex-shrink: 0;
  font-size: 11px;
  font-weight: 700;
  height: 24px;
  justify-content: center;
  overflow: hidden;
  position: relative;
  width: 24px;
}
.neo-examples-grid-issues .issues-avatar img {
  height: 100%;
  inset: 0;
  position: absolute;
  width: 100%;
}