.agentos-dockdemo-viewport {
  background: var(--dashboard-example-ground);
  color: var(--dashboard-example-ink);
  font-family: var(--dashboard-example-font-sans);
}

.agentos-dockdemo-workspace {
  background: var(--dashboard-example-ground);
}

.agentos-dockdemo-tourbar {
  background: var(--dashboard-example-panel);
  border-bottom: 1px solid var(--dashboard-example-line);
  flex: 0 0 auto;
  height: 52px;
  padding: 8px 12px;
}
.agentos-dockdemo-tourbar .agentos-dockdemo-tour-play {
  background: var(--dashboard-example-signal);
  border-radius: 7px;
  color: var(--dashboard-example-ground);
  font-family: var(--dashboard-example-font-mono);
  font-weight: 600;
}
.agentos-dockdemo-tourbar .agentos-dockdemo-tour-play .neo-button-glyph,
.agentos-dockdemo-tourbar .agentos-dockdemo-tour-play .neo-button-text {
  color: var(--dashboard-example-ground);
}
.agentos-dockdemo-tourbar .agentos-dockdemo-tour-play .neo-button-text {
  font-family: var(--dashboard-example-font-mono);
}
.agentos-dockdemo-tourbar .agentos-dockdemo-tour-caption {
  color: var(--dashboard-example-ink-dim);
  font-family: var(--dashboard-example-font-mono);
  font-size: 13px;
}

.agentos-dockdemo-tour-pips {
  display: flex;
  gap: 5px;
  padding: 0 4px;
}
.agentos-dockdemo-tour-pips .agentos-dockdemo-pip {
  background: var(--dashboard-example-line);
  border-radius: 3px;
  height: 5px;
  transition: background var(--motion-base) var(--ease-out-soft);
  width: 14px;
}
.agentos-dockdemo-tour-pips .agentos-dockdemo-pip-done {
  background: var(--dashboard-example-signal);
}

.agentos-dockdemo-dock-host {
  background: var(--dashboard-example-ground);
  padding: 8px;
  position: relative;
}

.agentos-dockdemo-pane {
  background: var(--dashboard-example-panel);
  border: 1px solid var(--dashboard-example-line-soft);
  border-radius: 8px;
  color: var(--dashboard-example-ink-dim);
  font-family: var(--dashboard-example-font-mono);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.agentos-dockdemo-clock-pane {
  align-items: center;
  background: var(--dashboard-example-panel-2);
  display: flex;
  flex-direction: column;
  gap: 6px;
  justify-content: center;
}
.agentos-dockdemo-clock-pane .agentos-dockdemo-clock-label {
  color: var(--dashboard-example-ink-dim);
  font-family: var(--dashboard-example-font-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.agentos-dockdemo-clock-pane .agentos-dockdemo-clock-time {
  color: var(--dashboard-example-signal);
  font-family: var(--dashboard-example-font-mono);
  font-size: 34px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.agentos-dockdemo-clock-pane .agentos-dockdemo-clock-note {
  color: var(--dashboard-example-ink-dim);
  font-family: var(--dashboard-example-font-mono);
  font-size: 11px;
}