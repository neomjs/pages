.agentos-dockdemo-switcher {
  background: var(--dashboard-example-panel);
  border-bottom: 1px solid var(--dashboard-example-line);
  flex: 0 0 auto;
  height: 44px;
  padding: 6px 12px;
}
.agentos-dockdemo-switcher .agentos-dockdemo-switcher-label {
  color: var(--dashboard-example-ink-dim);
  font-family: var(--dashboard-example-font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.agentos-dockdemo-switcher .agentos-dockdemo-switcher-btn {
  background: var(--dashboard-example-panel-2);
  border: 1px solid var(--dashboard-example-line);
  border-radius: 6px;
  color: var(--dashboard-example-ink);
  font-family: var(--dashboard-example-font-mono);
  margin-left: 6px;
}
.agentos-dockdemo-switcher .agentos-dockdemo-switcher-btn .neo-button-text {
  color: var(--dashboard-example-ink);
}

.agentos-dockdemo-restore-report {
  background: color-mix(in srgb, var(--dashboard-example-signal) 10%, var(--dashboard-example-panel));
  border-bottom: 1px solid var(--dashboard-example-line);
  color: var(--dashboard-example-ink);
  flex: 0 0 auto;
  font-family: var(--dashboard-example-font-mono);
  font-size: 11px;
  line-height: 1.45;
  padding: 7px 12px;
}
.agentos-dockdemo-restore-report strong {
  color: var(--dashboard-example-signal);
}

.agentos-dockdemo-counter-pane {
  align-items: center;
  background: var(--dashboard-example-panel);
  border: 1px solid var(--dashboard-example-line-soft);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  justify-content: center;
}
.agentos-dockdemo-counter-pane .agentos-dockdemo-counter-label {
  color: var(--dashboard-example-ink-dim);
  font-family: var(--dashboard-example-font-mono);
  font-size: 12px;
  letter-spacing: 0.12em;
}
.agentos-dockdemo-counter-pane .agentos-dockdemo-counter-value {
  color: var(--dashboard-example-signal);
  font-family: var(--dashboard-example-font-mono);
  font-size: 34px;
  font-weight: 700;
}
.agentos-dockdemo-counter-pane .agentos-dockdemo-counter-note {
  color: var(--dashboard-example-ink-dim);
  font-size: 11px;
  font-style: italic;
}

.agentos-dockdemo-popout-host {
  background: var(--dashboard-example-ground);
  padding: 10px;
}
.agentos-dockdemo-popout-host > * {
  flex: 1;
}

.agentos-dockdemo-kbd-live {
  color: var(--dashboard-example-ink-dim);
  font-size: 11px;
  min-height: 14px;
  padding: 0 12px;
}