.project-toolbar.neo-toolbar {
  align-items: center;
  gap: 8px;
  min-height: 64px;
  padding: 12px 24px;
  background: var(--project-header-bg);
  border-bottom: 1px solid var(--project-border);
}
.project-toolbar.neo-toolbar .project-title {
  color: var(--project-title);
  font-size: 18px;
  font-weight: 700;
}
.project-toolbar.neo-toolbar .project-subtitle, .project-toolbar.neo-toolbar .project-save-status {
  color: var(--project-muted);
  font-size: 12px;
}
.project-toolbar.neo-toolbar .project-control {
  --button-background-color-hover: var(--project-hover);
  --button-secondary-background-color-hover: var(--project-hover);
  --button-secondary-border-hover: 1px solid var(--project-border);
  --button-secondary-border-pressed: 1px solid var(--project-selected);
  --button-secondary-text-color: var(--project-muted);
  --button-secondary-text-color-active: var(--project-title);
  --button-secondary-text-color-hover: var(--project-title);
  --button-text-color: var(--project-muted);
  --button-text-color-active: var(--project-title);
  --button-text-color-hover: var(--project-title);
  background: var(--project-control);
  border: 1px solid var(--project-border);
  border-radius: 6px;
  min-height: 34px;
  padding: 0 12px;
}
.project-toolbar.neo-toolbar .project-control.pressed {
  --button-background-color-hover: var(--project-selected);
  --button-secondary-background-color-hover: var(--project-selected);
  --button-secondary-border-hover: 1px solid var(--project-selected);
  --button-secondary-border-pressed: 1px solid var(--project-selected);
  --button-secondary-text-color: var(--project-selected-text);
  --button-secondary-text-color-active: var(--project-selected-text);
  --button-secondary-text-color-hover: var(--project-selected-text);
  --button-text-color: var(--project-selected-text);
  --button-text-color-active: var(--project-selected-text);
  --button-text-color-hover: var(--project-selected-text);
  background: var(--project-selected);
  border-color: var(--project-selected);
}
.project-toolbar.neo-toolbar .project-control.pressed .neo-button-text {
  color: var(--project-selected-text);
}
.project-toolbar.neo-toolbar .project-control:focus-visible {
  outline: 2px solid var(--project-focus);
  outline-offset: 2px;
}