.neo-value-picker .neo-list-item {
  align-items: center;
  box-sizing: border-box;
  display: flex;
  gap: 0.5em;
}
.neo-value-picker .neo-value-picker-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.neo-value-picker .neo-value-picker-count {
  font-variant-numeric: tabular-nums;
  opacity: 0.65;
  text-align: end;
}
.neo-value-picker .neo-value-picker-refine {
  align-content: center;
  box-sizing: border-box;
  font-size: 0.875em;
  opacity: 0.65;
  overflow: hidden;
  padding: var(--list-item-padding);
  text-overflow: ellipsis;
  white-space: nowrap;
}