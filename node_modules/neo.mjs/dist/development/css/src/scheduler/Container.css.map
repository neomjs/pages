.neo-scheduler .neo-grid-header-toolbar {
  align-items: stretch;
  min-height: 56px;
}
.neo-scheduler .neo-grid-header-toolbar .neo-grid-header-button {
  height: 100%;
}
.neo-scheduler .neo-timeline-header .neo-timeline-header-major,
.neo-scheduler .neo-timeline-header .neo-timeline-header-minor {
  font-size: 12px;
}
.neo-scheduler .neo-grid-row .neo-grid-cell.neo-locked-start {
  align-items: center;
  border-right: 1px solid var(--neo-scheduler-divider-color);
  display: flex;
  font-weight: 500;
}
.neo-scheduler .neo-grid-row .neo-timeline-cell {
  height: 100%;
  padding: 0 !important;
  width: 100%;
}
.neo-scheduler .neo-timeline-bar {
  border-left-width: 4px;
  font-size: 12px;
}
.neo-scheduler .neo-timeline-bar .neo-timeline-bar-handle::after {
  background: currentColor;
  border-radius: 2px;
  content: "";
  height: 12px;
  opacity: 0.38;
  position: absolute;
  top: calc(50% - 6px);
  width: 2px;
}
.neo-scheduler .neo-timeline-bar .neo-resizable-start::after {
  left: 2px;
}
.neo-scheduler .neo-timeline-bar .neo-resizable-end::after {
  right: 2px;
}

.neo-scheduler-drag-preview {
  align-items: center;
  background: var(--neo-timeline-bar-background);
  border: 2px solid var(--neo-timeline-focus-color);
  border-radius: 4px;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
  color: var(--neo-timeline-bar-color);
  display: flex;
  font-size: 12px;
  height: 100%;
  opacity: 0.92;
  overflow: hidden;
  padding: 0 8px;
  white-space: nowrap;
  width: 100%;
}

.neo-scheduler .neo-timeline-bar.neo-scheduler-bar-emerald,
.neo-scheduler-drag-preview.neo-scheduler-bar-emerald {
  background: var(--neo-scheduler-bar-emerald-bg);
  border-color: var(--neo-scheduler-bar-emerald-border);
}
.neo-scheduler .neo-timeline-bar.neo-scheduler-bar-amber,
.neo-scheduler-drag-preview.neo-scheduler-bar-amber {
  background: var(--neo-scheduler-bar-amber-bg);
  border-color: var(--neo-scheduler-bar-amber-border);
}
.neo-scheduler .neo-timeline-bar.neo-scheduler-bar-violet,
.neo-scheduler-drag-preview.neo-scheduler-bar-violet {
  background: var(--neo-scheduler-bar-violet-bg);
  border-color: var(--neo-scheduler-bar-violet-border);
}

body:has(.neo-scheduler.neo-is-dragging) .neo-scheduler.neo-is-dragging .neo-grid-row, body:has(.neo-scheduler.neo-is-dragging) .neo-scheduler.neo-is-dragging .neo-grid-cell, body:has(.neo-scheduler.neo-is-dragging) .neo-scheduler.neo-is-dragging .neo-timeline-track {
  pointer-events: auto !important;
}