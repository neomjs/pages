.portal-services-component {
  position: relative;
  background: transparent !important;
}
.portal-services-component .portal-services-content-wrapper {
  background-color: transparent !important; /* Force transparent to reveal canvas */
  box-sizing: border-box;
  gap: 20px;
  height: 100%;
  overflow-y: auto;
  padding: 2em 1em;
  width: 100%;
  z-index: 1;
}
.portal-services-component .neo-h1 {
  margin-bottom: 1em;
  margin-top: 1em;
  text-align: center;
  text-shadow: var(--portal-services-headline-shadow);
  width: 100%;
}
.portal-services-component .portal-connect-intro {
  font-size: 1.2em;
  line-height: 1.6;
  margin: 0 auto 1em;
  max-width: 720px;
  text-align: center;
}

@media (max-width: 600px) {
  .portal-services-component .portal-services-content-wrapper {
    padding: 1em 0.5em;
  }
}