.portal-examples-list.neo-list {
  --portal-examples-list-scrim: color-mix(in srgb, var(--portal-examples-list-surface) 95%, transparent);
  --portal-examples-list-text-muted: color-mix(in srgb, var(--portal-examples-list-text) 78%, var(--portal-examples-list-surface));
  align-content: start;
  display: grid;
  gap: 20px;
  grid-auto-rows: max-content;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  padding: 16px 16px 0;
  transition: padding var(--portal-transition-duration) var(--ease-out-soft);
}
.portal-examples-list.neo-list .neo-list-item {
  border-radius: 16px;
  box-shadow: 0 0 0 1px var(--portal-examples-list-edge), 0 10px 28px rgba(0, 0, 0, 0.32);
  cursor: default;
  display: block;
  margin: 0;
  outline: 1px solid transparent;
  overflow: hidden;
  padding: 0;
  transition: box-shadow var(--motion-fast) var(--ease-out-soft), outline-color var(--motion-fast) var(--ease-out-soft), transform var(--motion-fast) var(--ease-out-soft);
  white-space: normal;
  width: 100%;
}
.portal-examples-list.neo-list .neo-list-item:hover {
  outline: 1px solid var(--portal-examples-list-link-hover);
  outline-offset: -1px;
  transform: translateY(-2px);
}
.portal-examples-list.neo-list .neo-list-item:focus-visible {
  outline: 2px solid var(--portal-examples-list-link-hover);
  outline-offset: -2px;
}
.portal-examples-list.neo-list .content {
  aspect-ratio: 16/9;
  container-type: inline-size;
  position: relative;
  width: 100%;
}
.portal-examples-list.neo-list .preview-image {
  background-image: linear-gradient(140deg, var(--portal-examples-list-gradient-start), var(--portal-examples-list-gradient-end));
  background-position: center top;
  background-size: cover;
  height: 100%;
  inset: 0;
  position: absolute;
  width: 100%;
}
.portal-examples-list.neo-list .neo-item-bottom-position {
  background: linear-gradient(to top, var(--portal-examples-list-scrim) 0%, var(--portal-examples-list-scrim) calc(100% - 28px), transparent 100%);
  bottom: 0;
  box-sizing: border-box;
  color: var(--portal-examples-list-text);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  left: 0;
  max-height: 100%;
  overflow: hidden;
  overflow-wrap: anywhere;
  padding: 30px 18px 13px;
  position: absolute;
  right: 0;
  z-index: 2;
}
.portal-examples-list.neo-list .neo-title {
  color: inherit;
  display: flex;
  flex: none;
  font-size: 18px;
  font-weight: 600;
  line-height: 1.25;
  text-decoration: none;
  transition: color var(--motion-fast) var(--ease-out-soft);
  width: fit-content;
}
.portal-examples-list.neo-list .portal-example-feature,
.portal-examples-list.neo-list .portal-example-look-for,
.portal-examples-list.neo-list .portal-example-scope {
  -webkit-box-orient: vertical;
  display: -webkit-box;
  overflow: hidden;
}
.portal-examples-list.neo-list .portal-example-feature {
  -webkit-line-clamp: 2;
  flex: none;
  font-size: 14px;
  line-height: 1.4;
  margin-top: 4px;
}
.portal-examples-list.neo-list .portal-example-more {
  display: grid;
  flex: none;
  grid-template-rows: 0fr;
  transition: grid-template-rows var(--motion-fast) var(--ease-out-soft);
}
.portal-examples-list.neo-list .portal-example-more-inner {
  min-height: 0;
  overflow: hidden;
}
.portal-examples-list.neo-list .neo-list-item:hover .portal-example-more,
.portal-examples-list.neo-list .neo-list-item:focus-within .portal-example-more,
.portal-examples-list.neo-list .neo-list-item.neo-selected .portal-example-more {
  grid-template-rows: 1fr;
}
.portal-examples-list.neo-list .portal-example-look-for {
  -webkit-line-clamp: 3;
  color: var(--portal-examples-list-text-muted);
  font-size: 13px;
  line-height: 1.45;
  margin: 6px 0 0;
}
.portal-examples-list.neo-list .portal-example-scope {
  -webkit-line-clamp: 2;
  color: var(--portal-examples-list-text-muted);
  font-size: 11.5px;
  line-height: 1.4;
  margin: 6px 0 0;
}
@container (max-width: 430px) {
  .portal-examples-list.neo-list .portal-example-look-for {
    -webkit-line-clamp: 2;
  }
  .portal-examples-list.neo-list .portal-example-scope {
    -webkit-line-clamp: 1;
  }
}
.portal-examples-list.neo-list .neo-top-20 {
  align-items: center;
  display: flex;
  margin-top: 10px;
}
.portal-examples-list.neo-list .neo-github-image {
  color: inherit;
  font-size: 17px;
  height: 17px;
  text-decoration: none;
  transition: color var(--motion-fast) var(--ease-out-soft);
  width: 17px;
}
.portal-examples-list.neo-list .neo-title:hover, .portal-examples-list.neo-list .neo-title:focus-visible,
.portal-examples-list.neo-list .neo-github-image:hover,
.portal-examples-list.neo-list .neo-github-image:focus-visible {
  color: var(--portal-examples-list-link-hover);
}
.portal-examples-list.neo-list .neo-inner-content {
  color: var(--portal-examples-list-text-muted);
  font-size: 11.5px;
  margin-left: 8px;
}
.portal-examples-list.neo-list .neo-inner-details {
  line-height: 1.4;
}
.portal-examples-list.neo-list .neo-multi-window {
  align-items: center;
  background: var(--portal-examples-list-scrim);
  border-radius: 50%;
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.3);
  color: var(--portal-examples-list-text);
  display: flex;
  height: 2em;
  justify-content: center;
  position: absolute;
  right: 1em;
  top: 1em;
  width: 2em;
  z-index: 3;
}
@media (max-width: 600px) {
  .portal-examples-list.neo-list {
    gap: 12px;
    padding: 8px 8px 0;
  }
  .portal-examples-list.neo-list .neo-list-item {
    border-radius: 12px;
  }
  .portal-examples-list.neo-list .neo-item-bottom-position {
    padding: 28px 14px 11px;
  }
  .portal-examples-list.neo-list .neo-title {
    font-size: 17px;
  }
  .portal-examples-list.neo-list .portal-example-feature {
    -webkit-line-clamp: 1;
    font-size: 13.5px;
  }
  .portal-examples-list.neo-list .neo-list-item.neo-selected .content {
    aspect-ratio: auto;
  }
  .portal-examples-list.neo-list .neo-list-item.neo-selected .preview-image {
    aspect-ratio: 16/9;
    height: auto;
    inset: auto;
    position: relative;
  }
  .portal-examples-list.neo-list .neo-list-item.neo-selected .neo-item-bottom-position {
    background: var(--portal-examples-list-surface);
    max-height: none;
    padding: 12px 14px 13px;
    position: relative;
  }
  .portal-examples-list.neo-list .neo-list-item.neo-selected .portal-example-feature,
  .portal-examples-list.neo-list .neo-list-item.neo-selected .portal-example-look-for,
  .portal-examples-list.neo-list .neo-list-item.neo-selected .portal-example-scope {
    -webkit-line-clamp: unset;
  }
}

.portal-examples-featured.portal-examples-list.neo-list {
  gap: 22px;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
  margin: 0 auto;
  max-width: 1280px;
}
.portal-examples-featured.portal-examples-list.neo-list .neo-title {
  font-size: 24px;
}
.portal-examples-featured.portal-examples-list.neo-list .portal-example-feature {
  font-size: 16px;
}
.portal-examples-featured.portal-examples-list.neo-list .portal-example-look-for {
  font-size: 14px;
}
@media (max-width: 600px) {
  .portal-examples-featured.portal-examples-list.neo-list {
    gap: 12px;
  }
  .portal-examples-featured.portal-examples-list.neo-list .neo-title {
    font-size: 18px;
  }
  .portal-examples-featured.portal-examples-list.neo-list .portal-example-feature {
    font-size: 14px;
  }
  .portal-examples-featured.portal-examples-list.neo-list .portal-example-look-for {
    font-size: 13px;
  }
}