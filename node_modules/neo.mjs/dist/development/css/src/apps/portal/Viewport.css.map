body > .neo-viewport {
  position: fixed;
}

.neo-viewport .portal-main-content {
  flex: 1 1 auto;
}
.neo-viewport .portal-main-content > * {
  flex: 1 0 100%;
}
.neo-viewport .neo-layout-cube.neo-animate .neo-box {
  transition: transform var(--motion-stage) var(--ease-out-soft);
}
.neo-viewport .neo-layout-cube .neo-face {
  opacity: 0.8;
  transition: opacity var(--motion-fast) var(--ease-out-soft);
}
.neo-viewport .neo-layout-cube .neo-plane {
  transform: translateZ(0px);
}
.neo-viewport .neo-worker-setup {
  align-items: center;
  background-color: #17141c;
  display: flex;
  height: 100%;
  justify-content: center;
  padding: 20px;
  width: 100%;
  --fill-opacity: 0.05;
  --stroke-opacity: 0.05;
}
.neo-viewport .neo-worker-setup:hover {
  --fill-opacity: 1;
  --stroke-opacity: 1;
}
.neo-viewport .portal-shared-background {
  background-attachment: fixed;
  background-color: var(--portal-bg-main);
  background-image: radial-gradient(at 0% 0%, rgba(62, 99, 221, 0.05) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(138, 43, 226, 0.05) 0px, transparent 50%);
}
.neo-viewport .portal-content-box {
  background-color: var(--sem-color-bg-neutral-default);
  border: 1px solid var(--sem-color-border-subtle);
  border-radius: 12px;
  box-sizing: border-box;
  color: var(--sem-color-text-neutral-default);
  cursor: pointer;
  display: flex;
  flex-direction: column;
  min-height: 300px;
  padding: 2rem;
  position: relative;
  text-align: left;
  text-decoration: none;
  transition: transform var(--motion-base) var(--ease-out-soft), box-shadow var(--motion-base) var(--ease-out-soft), border-color var(--motion-base) var(--ease-out-soft);
}
.neo-viewport .portal-content-box:hover {
  border-color: var(--sem-color-border-focus);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  transform: translateY(-4px);
}
.neo-viewport .portal-content-box:active {
  transform: scale(0.99);
}
.neo-viewport .portal-content-box .portal-content-box-headline {
  color: var(--sem-color-text-primary-default);
  margin: 0 0 1rem 0;
  padding-bottom: 0.5rem;
  text-align: left;
  transition: color var(--motion-fast) var(--ease-out-soft);
}
.neo-viewport .portal-content-box h4.portal-content-box-headline {
  font-family: "GT-Planar", sans-serif;
  font-size: 1.25rem;
  font-weight: 600;
}
.neo-viewport .portal-content-box .portal-content-box-content {
  flex: 1;
}
.neo-viewport .portal-content-box .portal-content-box-content ul {
  margin: 0;
  padding: 0 0 0 1.2em;
  list-style: disc;
}
.neo-viewport .portal-content-box .portal-content-box-content li {
  color: var(--sem-color-text-neutral-subdued);
  font-size: 1rem;
  line-height: 1.6;
  margin-bottom: 0.5rem;
}
.neo-viewport .portal-content-box .portal-content-box-content li::marker {
  color: var(--sem-color-text-primary-default);
}
.neo-viewport .portal-glass-card {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background: var(--portal-glass-card-background);
  border: var(--portal-glass-card-border);
  border-radius: 16px;
  box-shadow: var(--portal-glass-card-shadow);
  box-sizing: border-box;
  flex-shrink: 0;
  margin-left: auto;
  margin-right: auto;
  max-width: 800px;
  min-height: fit-content;
  opacity: 1;
  padding: 2.5em;
  transition: transform var(--motion-base) var(--ease-out-soft), box-shadow var(--motion-base) var(--ease-out-soft), border-color var(--motion-base) var(--ease-out-soft);
  width: 100%;
}
.neo-viewport .portal-glass-card:hover {
  border-color: var(--portal-glass-card-hover-border);
  box-shadow: var(--portal-glass-card-hover-shadow);
  transform: translateY(-5px);
}
.neo-viewport .portal-glass-card .portal-content-box-headline {
  font-size: 1.5em;
  font-weight: 600;
  margin-bottom: 1em;
  margin-top: 0;
  opacity: 0.9;
}
.neo-viewport .portal-glass-card .portal-content-box-content {
  font-size: 1.1em;
  line-height: 1.7;
  opacity: var(--portal-glass-card-text-opacity);
}
.neo-viewport .portal-glass-card .portal-content-box-content a {
  color: var(--portal-glass-card-link-color);
  font-weight: 600;
  text-decoration: none;
  transition: color var(--motion-fast) var(--ease-out-soft);
}
.neo-viewport .portal-glass-card .portal-content-box-content a:hover {
  color: var(--portal-glass-card-link-hover-color);
  text-decoration: underline;
}
.neo-viewport .portal-glass-card .portal-content-box-content a:focus-visible {
  outline: 2px solid var(--portal-glass-card-link-color);
  outline-offset: 4px;
}
.neo-viewport .portal-glass-card .portal-content-box-content ul {
  margin-top: 1em;
  padding-left: 1.5em;
}
.neo-viewport .portal-glass-card .portal-content-box-content ul li {
  list-style-type: disc;
  margin-bottom: 0.5em;
}
.neo-viewport .portal-glass-card .portal-connect-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75em 1.5em;
}

@media (max-width: 600px) {
  .neo-viewport .portal-glass-card {
    border-radius: 12px;
    padding: 1.5em;
  }
}