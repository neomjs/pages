:root .workstation-viewport[class*=neo-theme-],
:root .workstation-viewport [class*=neo-theme-] {
  --grid-container-border-color: var(--workstation-line);
  --grid-container-cell-background-color: var(--workstation-panel);
  --grid-container-cell-background-color-even: var(--workstation-panel-2);
  --grid-container-color: var(--workstation-ink-dim);
  --grid-container-header-cell-border-bottom: 1px solid var(--workstation-line);
  --grid-cell-background-color-hover: color-mix(in srgb, var(--workstation-signal) 10%, var(--workstation-panel));
  --grid-cell-progress-active-color: var(--workstation-signal);
  --grid-cell-progress-track-color: var(--workstation-line);
  --tab-button-background-color: transparent;
  --tab-button-background-color-active: color-mix(in srgb, var(--workstation-signal) 12%, transparent);
  --tab-button-background-color-hover: color-mix(in srgb, var(--workstation-signal) 8%, transparent);
  --tab-button-glyph-color: var(--workstation-ink-dim);
  --tab-button-text-color: var(--workstation-ink-dim);
  --tab-indicator-background-color-active: var(--workstation-signal);
  --tab-strip-background-color: var(--workstation-panel-2);
  --tab-header-action-background-color-active: color-mix(in srgb, var(--workstation-signal) 12%, transparent);
  --tab-header-action-background-color-hover: color-mix(in srgb, var(--workstation-signal) 8%, transparent);
  --tab-header-action-glyph-color: var(--workstation-ink-dim);
  --tab-header-action-glyph-color-active: var(--workstation-signal);
  --tab-header-action-glyph-color-hover: var(--workstation-signal);
  --tab-header-inline-background-image: linear-gradient(
      180deg,
      var(--workstation-panel-2),
      var(--workstation-panel)
  );
}

.workstation-viewport.neo-viewport {
  background: var(--workstation-ground);
}

.workstation-viewport.workstation-vessel-handover {
  position: relative;
}
.workstation-viewport.workstation-vessel-handover > .workstation-vessel-provisional-chrome {
  inset: 0;
  position: absolute;
  z-index: 1;
}

.workstation-popout-host > .workstation-vessel-dock-host {
  min-height: 0;
  min-width: 0;
  position: relative;
}

.workstation-vessel-dragproxy {
  opacity: 0.7;
}

.workstation-viewport.workstation-vessel-departing::after {
  animation: workstation-vessel-depart var(--motion-panel) var(--ease-in-soft) forwards;
  background: var(--workstation-ground);
  content: "";
  inset: 0;
  opacity: 0;
  position: fixed;
  z-index: 9999;
}

@keyframes workstation-vessel-depart {
  to {
    opacity: 1;
  }
}
.workstation-viewport .neo-tab-container:not(.neo-dashboard-dock-edge-band) {
  min-height: 0;
  min-width: 0;
}
.workstation-viewport .neo-tab-container > .neo-tab-body-container {
  background: transparent;
  border: 0;
}
.workstation-viewport .neo-tab-header-toolbar {
  background-color: var(--workstation-panel-2);
  border-bottom: 1px solid var(--workstation-line);
}
.workstation-viewport .neo-tab-header-button.pressed .neo-button-glyph,
.workstation-viewport .neo-tab-header-button.pressed .neo-button-text {
  color: var(--workstation-ink);
}
.workstation-viewport .neo-grid-header-button {
  --grid-header-button-background-color: var(--workstation-panel-2);
  --grid-header-button-background-color-hover: color-mix(in srgb, var(--workstation-signal) 12%, var(--workstation-panel-2));
  --grid-header-button-background-image: none;
  --grid-header-button-color: var(--workstation-ink);
  --grid-header-button-color-hover: var(--workstation-ink);
  --grid-header-button-glyph-color: var(--workstation-ink-dim);
  --grid-header-button-glyph-color-hover: var(--workstation-signal);
  --grid-header-button-justify-content: flex-end;
  --grid-header-button-padding: 0 10px;
}
.workstation-viewport .neo-grid-header-button .neo-button-glyph {
  position: absolute;
  right: 10px;
}

body:has(.workstation-viewport) .neo-grid-container.neo-dragproxy,
body:has(.workstation-viewport) .neo-grid-container.neo-dragproxy [class*=neo-theme-] {
  --grid-container-border-color: var(--workstation-line);
  --grid-container-cell-background-color: var(--workstation-panel);
  --grid-container-cell-background-color-even: var(--workstation-panel-2);
  --grid-container-color: var(--workstation-ink-dim);
  --grid-container-header-cell-border-bottom: 1px solid var(--workstation-line);
  --grid-cell-background-color-hover: color-mix(in srgb, var(--workstation-signal) 10%, var(--workstation-panel));
  --grid-cell-progress-active-color: var(--workstation-signal);
  --grid-cell-progress-track-color: var(--workstation-line);
}
body:has(.workstation-viewport) .neo-grid-container.neo-dragproxy .neo-grid-header-button {
  --grid-header-button-background-color: var(--workstation-panel-2);
  --grid-header-button-background-color-hover: color-mix(in srgb, var(--workstation-signal) 12%, var(--workstation-panel-2));
  --grid-header-button-background-image: none;
  --grid-header-button-color: var(--workstation-ink);
  --grid-header-button-color-hover: var(--workstation-ink);
  --grid-header-button-glyph-color: var(--workstation-ink-dim);
  --grid-header-button-glyph-color-hover: var(--workstation-signal);
  --grid-header-button-justify-content: flex-end;
  --grid-header-button-padding: 0 10px;
}
body:has(.workstation-viewport) .neo-grid-container.neo-dragproxy .neo-grid-header-button .neo-button-glyph {
  position: absolute;
  right: 10px;
}

.workstation-viewport .neo-button.workstation-row-action {
  --button-background-color: color-mix(in srgb, var(--workstation-signal) 8%, var(--workstation-panel-2));
  --button-background-color-active: color-mix(in srgb, var(--workstation-signal) 20%, var(--workstation-panel-2));
  --button-background-color-hover: color-mix(in srgb, var(--workstation-signal) 14%, var(--workstation-panel-2));
  --button-border: 1px solid color-mix(in srgb, var(--workstation-signal) 34%, var(--workstation-line));
  --button-border-active: 1px solid var(--workstation-signal);
  --button-border-hover: 1px solid color-mix(in srgb, var(--workstation-signal) 62%, var(--workstation-line));
  --button-glyph-color: var(--workstation-signal);
  --button-glyph-color-active: var(--workstation-signal);
  --button-glyph-color-hover: var(--workstation-signal);
  --button-ripple-background-color: color-mix(in srgb, var(--workstation-signal) 28%, transparent);
  --button-text-color: var(--workstation-ink-dim);
  --button-text-color-active: var(--workstation-ink);
  --button-text-color-hover: var(--workstation-ink);
  border-radius: 6px;
  font-family: var(--workstation-font-mono);
  height: 30px;
}

.workstation-data-pane {
  background: var(--workstation-panel);
  border: 1px solid var(--workstation-line-soft);
  border-radius: 8px;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
}
.workstation-data-pane .neo-grid-header-toolbar {
  background: var(--workstation-panel-2);
}
.workstation-data-pane .neo-sparkline-wrapper {
  contain: strict;
  height: 100%;
  min-width: 0;
  position: relative;
  width: 100%;
}
.workstation-data-pane .neo-sparkline-wrapper .neo-sparkline-canvas {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}

.workstation-pane-repaint {
  will-change: transform;
}

.workstation-placeholder {
  background: radial-gradient(circle at 82% 16%, color-mix(in srgb, var(--workstation-signal) 16%, transparent), transparent 38%), linear-gradient(145deg, var(--workstation-panel), color-mix(in srgb, var(--workstation-signal) 5%, var(--workstation-panel-2)));
  border: 1px solid var(--workstation-line-soft);
  border-radius: 8px;
  container: workstation-pane/size;
  overflow: hidden;
  padding: 0;
  position: relative;
}
.workstation-placeholder::after {
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--workstation-signal) 55%, transparent), transparent);
  content: "";
  height: 1px;
  left: 8%;
  position: absolute;
  right: 8%;
  top: 0;
}

.workstation-resident-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  overflow: clip;
  padding: clamp(12px, 2px + 5cqh, 24px);
  position: relative;
}

.workstation-resident-kicker,
.workstation-resident-icon,
.workstation-resident-metric,
.workstation-resident-title {
  flex-shrink: 0;
}

.workstation-resident-kicker {
  align-items: center;
  color: var(--workstation-ink-dim);
  display: flex;
  font-family: var(--workstation-font-mono);
  font-size: 10px;
  font-weight: 700;
  gap: 7px;
  letter-spacing: 0.13em;
}
.workstation-resident-kicker span {
  background: var(--workstation-state-ok);
  border-radius: 50%;
  box-shadow: 0 0 12px color-mix(in srgb, var(--workstation-state-ok) 72%, transparent);
  height: 6px;
  width: 6px;
}

.workstation-resident-icon {
  color: color-mix(in srgb, var(--workstation-signal) 72%, var(--workstation-ink));
  font-size: clamp(18px, 12px + 2.6cqh, 30px);
  margin: auto 0 8px;
  opacity: 0.82;
}

.workstation-resident-metric {
  color: var(--workstation-ink);
  font-family: var(--workstation-font-mono);
  font-size: clamp(24px, 12px + 8cqh, 58px);
  font-weight: 800;
  letter-spacing: -0.06em;
  line-height: 0.95;
  text-shadow: 0 0 28px color-mix(in srgb, var(--workstation-signal) 18%, transparent);
}

.workstation-resident-title {
  color: var(--workstation-ink);
  font-family: var(--workstation-font-sans);
  font-size: clamp(11px, 9px + 1.2cqh, 16px);
  font-weight: 650;
  letter-spacing: 0.02em;
  margin-top: 8px;
}

.workstation-resident-footer {
  align-items: center;
  border-top: 1px solid var(--workstation-line-soft);
  color: var(--workstation-ink-faint);
  display: flex;
  font-family: var(--workstation-font-mono);
  font-size: 9px;
  gap: 8px;
  justify-content: space-between;
  margin-top: 14px;
  padding-top: 9px;
  text-transform: uppercase;
}
.workstation-resident-footer strong {
  color: var(--workstation-state-ok);
  font-size: 9px;
  letter-spacing: 0.12em;
}

.workstation-resident-wave {
  align-items: end;
  display: flex;
  flex-shrink: 0;
  gap: 3px;
  height: 15px;
  margin-top: 9px;
}
.workstation-resident-wave i {
  background: color-mix(in srgb, var(--workstation-signal) 68%, var(--workstation-line));
  border-radius: 2px;
  display: block;
  height: 40%;
  width: 8px;
}
.workstation-resident-wave i:nth-child(2), .workstation-resident-wave i:nth-child(5) {
  height: 78%;
}
.workstation-resident-wave i:nth-child(3) {
  height: 100%;
}
.workstation-resident-wave i:nth-child(4) {
  height: 62%;
}
.workstation-resident-wave i:nth-child(6) {
  height: 28%;
}

@container workstation-pane (max-height: 170px) {
  .workstation-resident-wave {
    display: none;
  }
}
@container workstation-pane (max-height: 145px) {
  .workstation-resident-footer {
    display: none;
  }
}
@container workstation-pane (max-height: 118px) {
  .workstation-resident-icon {
    display: none;
  }
}
@container workstation-pane (max-height: 92px) {
  .workstation-resident-title {
    display: none;
  }
}
@container workstation-pane (max-height: 64px) {
  .workstation-resident-card {
    justify-content: center;
    padding: 6px 12px;
  }
  .workstation-resident-kicker {
    display: none;
  }
}
@container workstation-pane (max-height: 40px) {
  .workstation-resident-card {
    padding: 0;
  }
  .workstation-resident-metric {
    display: none;
  }
}
.workstation-heat-0 {
  background: color-mix(in srgb, var(--workstation-panel-2) 92%, var(--workstation-signal));
}

.workstation-heat-1 {
  background: color-mix(in srgb, var(--workstation-panel-2) 84%, var(--workstation-signal));
}

.workstation-heat-2 {
  background: color-mix(in srgb, var(--workstation-panel-2) 76%, var(--workstation-signal));
}

.workstation-heat-3 {
  background: color-mix(in srgb, var(--workstation-panel-2) 66%, var(--workstation-signal));
}