.webdesktop-permission-panel {
  backdrop-filter: blur(28px) saturate(160%);
  background-color: var(--webdesktop-glass-strong);
  border-left: 1px solid var(--webdesktop-glass-border);
  position: relative;
  width: 320px;
  z-index: 100;
}
.webdesktop-permission-panel .webdesktop-panel-header {
  padding: 22px 20px 12px;
}
.webdesktop-permission-panel .webdesktop-panel-header h2 {
  font-size: 17px;
  font-weight: 700;
  margin: 0 0 6px;
}
.webdesktop-permission-panel .webdesktop-panel-header p {
  color: var(--webdesktop-ink-dim);
  font-size: 13px;
  line-height: 1.5;
  margin: 0;
}

@media (max-width: 600px) {
  .webdesktop-permission-panel {
    border-left: none;
    inset: 0;
    position: absolute;
    width: auto;
  }
}