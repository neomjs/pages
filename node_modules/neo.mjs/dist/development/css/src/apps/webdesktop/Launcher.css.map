.webdesktop-launcher,
.webdesktop-launcher-proxy {
  --list-container-list-color: var(--webdesktop-ink);
  --list-item-background-color: transparent;
  --list-item-background-color-active: var(--webdesktop-glass-active);
  --list-item-background-color-hover: var(--webdesktop-glass-hover);
  --list-item-background-color-selected: var(--webdesktop-glass-active);
  --list-item-color-selected: var(--webdesktop-ink);
  --list-item-focus-outline: 2px solid var(--webdesktop-accent);
  --list-item-focus-outline-offset: 2px;
  --list-item-padding: 10px 4px 8px;
}
.webdesktop-launcher .neo-list-item:not(.neo-list-header),
.webdesktop-launcher-proxy .neo-list-item:not(.neo-list-header) {
  align-items: center;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 0;
  transition: background-color var(--motion-fast) var(--ease-out-soft), transform var(--motion-base) var(--ease-out-soft);
}
.webdesktop-launcher .neo-list-item:not(.neo-list-header):hover,
.webdesktop-launcher-proxy .neo-list-item:not(.neo-list-header):hover {
  transform: translateY(-2px);
}
.webdesktop-launcher .neo-list-item:not(.neo-list-header):hover .webdesktop-app-icon,
.webdesktop-launcher-proxy .neo-list-item:not(.neo-list-header):hover .webdesktop-app-icon {
  box-shadow: 0 16px 34px -10px color-mix(in srgb, var(--webdesktop-app-color) 85%, transparent), inset 0 1px 0 rgba(255, 255, 255, 0.35);
}
.webdesktop-launcher .webdesktop-app-icon,
.webdesktop-launcher-proxy .webdesktop-app-icon {
  align-items: center;
  background: linear-gradient(145deg, color-mix(in srgb, var(--webdesktop-app-color) 70%, white), var(--webdesktop-app-color) 55%, color-mix(in srgb, var(--webdesktop-app-color) 82%, black));
  border-radius: 16px;
  box-shadow: 0 10px 24px -10px color-mix(in srgb, var(--webdesktop-app-color) 75%, transparent), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  color: #fff;
  display: flex;
  font-size: 24px;
  height: 56px;
  justify-content: center;
  transition: box-shadow var(--motion-base) var(--ease-out-soft);
  width: 56px;
}
.webdesktop-launcher .webdesktop-app-label,
.webdesktop-launcher-proxy .webdesktop-app-label {
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-shadow: var(--webdesktop-label-shadow);
}

.webdesktop-launcher {
  align-content: start;
  display: grid;
  gap: 6px 8px;
  grid-template-columns: repeat(auto-fill, 100px);
  padding: 28px 32px;
}
.webdesktop-launcher .neo-list-header {
  border-bottom: 1px solid var(--webdesktop-glass-border);
  color: var(--webdesktop-ink-dim);
  font-size: 11px;
  font-weight: 700;
  grid-column: 1/-1;
  letter-spacing: 0.09em;
  margin: 14px 0 6px;
  padding: 0 2px 8px;
  text-shadow: var(--webdesktop-label-shadow);
  text-transform: uppercase;
}
.webdesktop-launcher .neo-list-header:first-child {
  margin-top: 0;
}
.webdesktop-launcher .neo-list-item.neo-sort-source {
  opacity: 0.3;
  transform: none;
}

.webdesktop-launcher-proxy .neo-list-item {
  background-color: var(--webdesktop-glass-active);
  box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.55);
}

@media (max-width: 600px) {
  .webdesktop-launcher {
    gap: 4px;
    grid-template-columns: repeat(auto-fill, 80px);
    padding: 16px;
  }
  .webdesktop-launcher .webdesktop-app-icon,
  .webdesktop-launcher-proxy .webdesktop-app-icon {
    border-radius: 14px;
    font-size: 21px;
    height: 48px;
    width: 48px;
  }
  .webdesktop-launcher .webdesktop-app-label,
  .webdesktop-launcher-proxy .webdesktop-app-label {
    font-size: 12px;
  }
}