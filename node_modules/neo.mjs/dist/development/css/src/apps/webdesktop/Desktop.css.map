.webdesktop-desktop {
  min-height: 0;
}
.webdesktop-desktop .webdesktop-workspace {
  min-height: 0;
  position: relative;
}
.webdesktop-desktop .webdesktop-launcher-area {
  min-width: 0;
  position: relative;
}
.webdesktop-desktop .webdesktop-empty {
  align-items: center;
  color: var(--webdesktop-ink-dim);
  display: flex;
  flex-direction: column;
  gap: 12px;
  inset: 0;
  justify-content: center;
  pointer-events: none;
  position: absolute;
  text-align: center;
}
.webdesktop-desktop .webdesktop-empty i {
  font-size: 34px;
  opacity: 0.7;
}
.webdesktop-desktop .webdesktop-empty p {
  font-size: 15px;
  margin: 0;
  max-width: 320px;
}