.neo-dialog.webdesktop-window {
  --container-background-color: transparent;
  backdrop-filter: blur(30px) saturate(160%);
  background-color: var(--webdesktop-glass-strong);
  border: 1px solid var(--webdesktop-glass-border);
  border-radius: 16px;
  box-shadow: var(--webdesktop-shadow);
  color: var(--webdesktop-ink);
  overflow: hidden;
}
.neo-dialog.webdesktop-window .neo-header-toolbar {
  --dialog-header-color: var(--webdesktop-ink);
  --dialog-icon-color: var(--webdesktop-ink-dim);
  --toolbar-background-color: transparent;
  border-bottom: 1px solid var(--webdesktop-glass-border);
}
.neo-dialog.webdesktop-window.neo-maximized {
  border-radius: 0;
  height: calc(100% - 60px) !important;
  left: 0 !important;
  top: 0 !important;
  width: 100% !important;
}

@media (min-width: 601px) {
  body:has(.webdesktop-permission-panel) .neo-dialog.webdesktop-window.neo-maximized {
    width: calc(100% - 320px) !important;
  }
}
@media (max-width: 600px) {
  .neo-dialog.webdesktop-window {
    border-radius: 0;
    height: calc(100% - 60px) !important;
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
  }
  .neo-dialog.webdesktop-window .neo-toolbar-action[aria-label=maximize] {
    display: none;
  }
}