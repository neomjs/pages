.webdesktop-task-list {
  --list-container-list-color: var(--webdesktop-ink);
  --list-item-background-color: transparent;
  --list-item-background-color-active: var(--webdesktop-glass-active);
  --list-item-background-color-hover: var(--webdesktop-glass-hover);
  --list-item-focus-outline: 2px solid var(--webdesktop-accent);
  --list-item-focus-outline-offset: -2px;
  --list-item-padding: 0 12px 0 8px;
  align-items: center;
  display: flex;
  gap: 4px;
  margin-left: 6px;
  overflow: visible;
}
.webdesktop-task-list .neo-list-item {
  align-items: center;
  border-radius: 12px;
  display: flex;
  gap: 8px;
  height: 40px;
  position: relative;
}
.webdesktop-task-list .neo-list-item::after {
  background-color: var(--webdesktop-accent);
  border-radius: 2px;
  bottom: 3px;
  content: "";
  height: 3px;
  left: 50%;
  position: absolute;
  transform: translateX(-50%) scaleX(1);
  transition: transform var(--motion-base) var(--ease-out-soft);
  width: 18px;
}
.webdesktop-task-list .neo-list-item.webdesktop-task-minimized {
  opacity: 0.65;
}
.webdesktop-task-list .neo-list-item.webdesktop-task-minimized::after {
  transform: translateX(-50%) scaleX(0.3333);
}
.webdesktop-task-list .webdesktop-task-icon {
  align-items: center;
  background-color: var(--webdesktop-app-color);
  border-radius: 8px;
  color: #fff;
  display: flex;
  font-size: 13px;
  height: 26px;
  justify-content: center;
  width: 26px;
}
.webdesktop-task-list .webdesktop-task-text {
  font-size: 13px;
  font-weight: 600;
}