.webdesktop-taskbar {
  --button-background-color: transparent;
  --button-background-color-active: var(--webdesktop-glass-active);
  --button-background-color-hover: var(--webdesktop-glass-hover);
  --button-border-radius: 12px;
  --button-glyph-color: var(--webdesktop-ink);
  --button-glyph-color-active: var(--webdesktop-ink);
  --button-glyph-color-hover: var(--webdesktop-ink);
  --button-height: 40px;
  --button-text-color: var(--webdesktop-ink);
  --button-text-color-active: var(--webdesktop-ink);
  --button-text-color-hover: var(--webdesktop-ink);
  backdrop-filter: blur(24px) saturate(160%);
  background-color: var(--webdesktop-glass-strong);
  border-top: 1px solid var(--webdesktop-glass-border);
  gap: 6px;
  height: 60px;
  padding: 0 12px;
}
.webdesktop-taskbar .neo-button.pressed {
  background-color: var(--webdesktop-glass-active);
}
.webdesktop-taskbar .webdesktop-start-button {
  --button-background-color: var(--webdesktop-accent);
  --button-background-color-active: color-mix(in srgb, var(--webdesktop-accent) 80%, black);
  --button-background-color-hover: color-mix(in srgb, var(--webdesktop-accent) 85%, white);
  --button-glyph-color: #fff;
  --button-glyph-color-active: #fff;
  --button-glyph-color-hover: #fff;
  --button-text-color: #fff;
  --button-text-color-active: #fff;
  --button-text-color-hover: #fff;
  box-shadow: 0 8px 20px -8px var(--webdesktop-accent);
}

.webdesktop-start-menu,
.webdesktop-viewport .neo-menu-list {
  backdrop-filter: blur(24px) saturate(160%);
  border-radius: 14px;
  box-shadow: var(--webdesktop-shadow);
  min-width: 220px;
  padding: 6px;
}
.webdesktop-start-menu .neo-list-item,
.webdesktop-viewport .neo-menu-list .neo-list-item {
  border-radius: 9px;
  font-size: 13.5px;
  font-weight: 500;
}

@media (max-width: 600px) {
  .webdesktop-taskbar {
    gap: 2px;
    padding: 0 6px;
  }
  .webdesktop-taskbar .neo-button-text,
  .webdesktop-taskbar .webdesktop-account-text,
  .webdesktop-taskbar .webdesktop-task-text {
    clip: rect(0 0 0 0);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
  .webdesktop-taskbar .webdesktop-account-chip {
    padding: 0 4px;
  }
  .webdesktop-taskbar .webdesktop-task-list {
    max-width: 40vw;
    overflow-x: auto;
    scrollbar-width: none;
  }
}