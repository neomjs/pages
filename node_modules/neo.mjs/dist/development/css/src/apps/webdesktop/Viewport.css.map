.webdesktop-viewport {
  --container-background-color: transparent;
  background: var(--webdesktop-wallpaper);
  color: var(--webdesktop-ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  overflow: hidden;
}
.webdesktop-viewport h1, .webdesktop-viewport h2, .webdesktop-viewport p {
  font-family: inherit;
}
.webdesktop-viewport .webdesktop-avatar {
  align-items: center;
  background: linear-gradient(140deg, color-mix(in srgb, var(--webdesktop-avatar-color) 68%, white), var(--webdesktop-avatar-color));
  border-radius: 50%;
  box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--webdesktop-avatar-color) 80%, transparent);
  color: #fff;
  display: flex;
  flex: none;
  font-size: 15px;
  font-weight: 700;
  height: 44px;
  justify-content: center;
  letter-spacing: 0.02em;
  width: 44px;
}
.webdesktop-viewport .webdesktop-account-text {
  min-width: 0;
}
.webdesktop-viewport .webdesktop-account-name {
  font-weight: 600;
  line-height: 1.25;
}
.webdesktop-viewport .webdesktop-account-role {
  color: var(--webdesktop-ink-dim);
  font-size: 12.5px;
  line-height: 1.3;
  margin-top: 2px;
}