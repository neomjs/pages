.email-main-view {
  display: flex;
  flex: 2;
  height: 100%;
  min-width: 440px;
}
.email-main-view .email-navigation {
  flex: 0 0 150px;
  padding: 16px;
}
.email-main-view .email-navigation .neo-button {
  width: 100%;
}
.email-main-view .email-navigation h2 {
  font-size: 16px;
}
.email-main-view .email-navigation p {
  font-size: 12px;
}
.email-main-view .email-inbox {
  flex: 1;
  min-width: 0;
}