.email-compose-dialog {
  left: auto;
  max-width: 100%;
  right: 24px;
  top: 72px;
}
.email-compose-dialog.neo-maximized {
  height: 100% !important;
  left: 0 !important;
  top: 0 !important;
  width: 100% !important;
}

.email-popup .email-compose-dialog {
  height: 100% !important;
  left: 0 !important;
  top: 0 !important;
  transform: none !important;
  width: 100% !important;
}