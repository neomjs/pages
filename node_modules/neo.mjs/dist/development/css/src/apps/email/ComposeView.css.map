.email-compose-view {
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 100%;
  padding: 16px;
  width: 100%;
}
.email-compose-view .email-draft-body {
  flex: 1;
  min-height: 100px;
}
.email-compose-view .email-draft-body .neo-label-wrapper {
  display: flex;
  flex-direction: column;
}
.email-compose-view .email-draft-body .neo-input-wrapper {
  min-height: 0;
}
.email-compose-view .email-draft-body textarea {
  height: 100%;
}
.email-compose-view .email-demo-note {
  font-size: 12px;
  margin: 0;
}