:root .neo-theme-light {
  --list-scrollbar-color-scheme: light;
  --list-container-background-color: #fff;
  --list-container-border: 0;
  --list-container-list-color: rgb(38.2142857143%, 38.9635854342%, 45.7072829132%);
  --list-item-background-color: #fff;
  --list-item-background-color-hover: rgb(91.2429971989%, 91.3865546218%, 92.6785714286%);
  --list-item-background-color-selected: rgb(80.8010521282%, 90.8340506934%, 98.8852223816%);
  --list-item-color-selected: #2b2b2b;
  --list-item-focus-outline: 1px solid darkorange;
  --list-item-focus-outline-offset: -1px;
  --list-item-glyph-color: rgb(38.2142857143%, 38.9635854342%, 45.7072829132%);
  --list-item-highlight-search-color: red;
  --list-item-padding: 5px;
}