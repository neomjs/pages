w (vertical scroll target)</p>\n","name":"data.viewId"},{"type":{"names":["String"]},"description":"<p>The ID of the grid container (horizontal scroll target)</p>\n","name":"data.containerId"},{"type":{"names":["String"]},"description":"<p>Unique identifier for the registration (e.g. ScrollManager id)</p>\n","name":"data.id"}],"name":"register","longname":"GridDragScroll#register","kind":"function","memberof":"GridDragScroll","scope":"instance","$longname":"GridDragScroll#register","$kind":"method","id":9497,"neoClassName":"Neo.main.addon.GridDragScroll"},{"comment":"/**\n     * @param {Object} monitor\n     * @param {Number} x\n     * @param {Number} y\n     * @param {String} inputType 'mouse' or 'touch'\n     */","meta":{"range":[15584,16816],"filename":"GridDragScroll.mjs","lineno":415,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100070516","name":"GridDragScroll#startDrag","type":"MethodDefinition","paramnames":["monitor","x","y","inputType"]},"vars":{"":null}},"params":[{"type":{"names":["Object"]},"name":"monitor"},{"type":{"names":["Number"]},"name":"x"},{"type":{"names":["Number"]},"name":"y"},{"type":{"names":["String"]},"description":"<p>&#39;mouse&#39; or &#39;touch&#39;</p>\n","name":"inputType"}],"name":"startDrag","longname":"GridDragScroll#startDrag","kind":"function","memberof":"GridDragScroll","scope":"instance","$longname":"GridDragScroll#startDrag","$kind":"method","id":9498,"neoClassName":"Neo.main.addon.GridDragScroll"},{"comment":"/**\n     * Unregisters a grid.\n     * @param {Object} data\n     * @param {String} data.id\n     */","meta":{"range":[16924,17975],"filename":"GridDragScroll.mjs","lineno":449,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100070670","name":"GridDragScroll#unregister","type":"MethodDefinition","paramnames":[""]},"vars":{"":null}}