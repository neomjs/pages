 mouseDownTimeout\n     */","meta":{"range":[11205,11717],"filename":"GridDragScroll.mjs","lineno":304,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100070134","name":"GridDragScroll#onMonitorMove","type":"MethodDefinition","paramnames":["event"]},"vars":{"":null}},"description":"<p>Detect change in distance, starting drag when both delay and distance requirements are met</p>\n","params":[{"type":{"names":["MouseEvent","TouchEvent","Object"]},"description":"<p>Object in case it does get trigger via the mouseDownTimeout</p>\n","name":"event"}],"name":"onMonitorMove","longname":"GridDragScroll#onMonitorMove","kind":"function","memberof":"GridDragScroll","scope":"instance","$longname":"GridDragScroll#onMonitorMove","$kind":"method","id":9493,"neoClassName":"Neo.main.addon.GridDragScroll"},{"comment":"/**\n     * @param {MouseEvent|TouchEvent} event\n     */","meta":{"range":[11783,12268],"filename":"GridDragScroll.mjs","lineno":320,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100070222","name":"GridDragScroll#onMonitorEnd","type":"MethodDefinition","paramnames":["event"]},"vars":{"":null}},"params":[{"type":{"names":["MouseEvent","TouchEvent"]},"name":"event"}],"name":"onMonitorEnd","longname":"GridDragScroll#onMonitorEnd","kind":"function","memberof":"GridDragScroll","scope":"instance","$longname":"GridDragScroll#onMonitorEnd","$kind":"method","id":9494,"neoClassName":"Neo.main.addon.GridDragScroll"},{"comment":"/**\n     * A native HTML5 drag has begun somewhere in the document — `Neo.main.addon.NativeDragSource`\n     * arms grid rows for one, and any foreign `draggable` node qualifies too. The gesture this addon\n     * was tracking is over at this moment: the browser will not deliver the `mousemove` that would\n     * feed it or the `mouseup` that would end it. A monitor left armed would qualify on the next\n     * button-less pointer move (elapsed time and distance from the original press both pass) and\n     * start a drag-scroll nobody is holding, with the grabbing cursor stuck on the body; an active\n     * drag would keep scrolling under the pointer for the same reason. Both end here — the active\n     * drag without a kinetic tail, since nothing was released.\n     * @param {DragEvent} event\n     */","meta":{"range":[13082,13236],"filename":"GridDragScroll.mjs","lineno":343,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100070293","name":"GridDragScroll#onNativeDragStart","type":"MethodDefinition","paramnames":["event"]},"vars":{"":null}},"description":"<p>A native HTML5 drag has begun somewhere in the document — <code>Neo.main.addon.NativeDragSource</code>\narms grid rows for one, and any foreign <code>draggable</code> node qualifies too. The gesture this addon\nwas tracking is over at this moment: the browser will not deliver the <code>mousemove</code> that would\nfeed it or the <code>mouseup</code> that would end it. A monitor left armed would qualify on the next\nbutton-less pointer move (elapsed time and distance from the original press both pass) and\nstart a drag-scroll nobody is holding, with the grabbing cursor stuck on the body; an active\ndrag would keep scrolling under the pointer for the same reason. Both end here — the active\ndrag without a kinetic tail, since nothing was released.</p>\n","params":[{"type":{"names":["DragEvent"]},"name":"event"}],"name":"onNativeDragStart","longname":"GridDragScroll#onNativeDragStart","kind":"function","memberof":"GridDragScroll","scope":"instance","$longname":"GridDragScroll#onNativeDragStart","$kind":"method","id":9495,"neoClassName":"Neo.main.addon.GridDragScroll"},{"comment":"/**\n     * Drops an active drag on the floor: no fling, cursor restored, listeners and a running kinetic\n     