ket#createSocket","kind":"function","memberof":"Socket","scope":"instance","params":[],"$longname":"Socket#createSocket","$kind":"method","id":6815,"neoClassName":"Neo.data.connection.WebSocket"},{"comment":"/**\n     *\n     */","meta":{"range":[4442,4519],"filename":"WebSocket.mjs","lineno":173,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages-51/node_modules/neo.mjs/src/data/connection","code":{"id":"astnode100105483","name":"Socket#destroy","type":"MethodDefinition","paramnames":["args"]},"vars":{"":null}},"name":"destroy","longname":"Socket#destroy","kind":"function","memberof":"Socket","scope":"instance","params":[],"$longname":"Socket#destroy","$kind":"method","id":6816,"neoClassName":"Neo.data.connection.WebSocket"},{"comment":"/**\n     * @summary Publishes the native close fields and applies this connection's retry policy.\n     * @param {CloseEvent} event The Websocket generated CloseEvent\n     * @param {Number}     event.code The WebSocket connection close code provided by the server\n     *\n     *        Code        Name                  Description\n     *        0-999                             Reserved and not used.\n     *        1000        CLOSE_NORMAL          Normal closure; the connection successfully completed whatever purpose for which it was created.\n     *        1001        CLOSE_GOING_AWAY      The endpoint is going away, either because of a server failure or because the browser is navigating away from the page that opened the connection.\n     *        1002        CLOSE_PROTOCOL_ERROR  The endpoint is terminating the connection due to a protocol error.\n     *        1003        CLOSE_UNSUPPORTED     The connection is being terminated because the endpoint received data of a type it cannot accept (for example, a text-only endpoint received binary data).\n     *        1004        CLOSE_TOO_LARGE       The endpoint is terminating the connection because a data frame was received that is too large.\n     *        1005        CLOSE_NO_STATUS       Reserved.  Indicates that no status code was provided even though one was expected.\n     *        1006        CLOSE_ABNORMAL        Reserved. Used to indicate that a connection was closed abnormally (that is, with no close frame being sent) when a status code is expected.\n     *        1007-1999                         Reserved for future use by the WebSocket standard.\n     *        2000-2999                         Reserved for use by WebSocket extensions.\n     *        3000-3999                         Available for use by libraries and frameworks. May not be used by applications.\n     *        4000-4999                         Available for use by applications.\n     *\n     * @param {String}     event.reason The reason the server closed the connection.\n     * @param {Boolean}    event.wasClean Whether the connection was cleanly closed.\n     */","meta":{"range":[6639,6884],"filename":"WebSocket.mjs","lineno":200,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages-51/node_modules/neo.mjs/src/data/connection","code":{"id":"astnode100105501","name":"Socket#onClose","type":"MethodDefinition","paramnames":["event"]},"vars":{"":null}},"summary":"Publishes the native close fields and applies this connection's retry policy.","params":[{"type":{"names":["CloseEvent"]},"description":"<p>The Websocket generated CloseEvent</p>\n","name":"event"},{"type":{"names":["Number"]},"description":"<p>The WebSocket connection close code provided by the server</p>\n<pre><code>   Code        Name                  Description\n   0-999                             Reserved and not used.\n   1000        CLOSE_NORMAL          Normal closure; the connection successfully completed whatever purpose for which it was created.\n   1001        CLOSE_GOING_AWAY      The endpoint is going away, either because of a server failure or because the browser is navigating away from the page that opened the connection.\n   1002        CLOSE_PROTOCOL_ERROR  The endpoint is terminating the connection due to a protocol error.\n   1003        CLOSE_UNSUPPORTED     The connection is being terminated because the endpoint received data of a type it cannot accept (for example, a text-only endpoint received binary data).\n   1004        CLOSE_TOO_LARGE       The endpoint is terminating the connection because a data frame was received that is too large.\n   1005        CLOSE_NO_STATUS       Reserved.  Indicates that no status code was provided even though one was expected.\n   1006        CLOSE_ABNORMAL        Reserved. Used to indicate that a connection was closed abnormally (that is, with no close frame being sent) when a status code is expected.\n   1007-1999                         Reserved for future use by the WebSocket standard.\n   2000-2999                         Reserved for use by WebSocket extensions.\n   3000-3999                         Available for use by libraries and frameworks. May not be used by applications.\n   4000-4999                         Available for use by applications.\n</code></pre>\n","name":"event.code"},{"type":{"names":["String"]},"description":"<p>The reason the server closed the connection.</p>\n","name":"event.reason"},{"type":{"names":["Boolean"]},"description":"<p>Whether the connection was cleanly closed.</p>\n","name":"event.wasClean"}],"name":"onClose","longname":"Socket#onClose","kind":"function","memberof":"Socket","scope":"instance","$longname":"Socket#onClose","$kind":"method","id":6817,"neoClassName":"Neo.data.connection.WebSocket"},{"comment":"/**\n     *\n     */","meta":{"range":[6913,6971],"filename":"WebSocket.mjs","lineno":213,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages-51/node_modules/neo.mjs/src/data/connection","code":{"id":"astnode100105546","name":"Socket#onError","type":"MethodDefinition","paramnames":["error"]},"vars":{"":null}},"name":"onError","longname":"Socket#onError","kind":"function","membe