oggle and adds <code>minimize</code>, both dressed from its own configs\n(<code>Neo.dialog.Base#getWindowActionMap</code>). Its <code>headerConfig.actionMap</code> replaces the entries it names and\nkeeps the others.</p>\n","examples":["// A close glyph of its own, with the dialog's maximize kept\nheaderConfig: {actionMap: {close: () => ({action: 'close', iconCls: 'far fa-circle-xmark'})}}"],"kind":"member","name":"actionMap","type":{"names":["Object"]},"longname":"actionMap","scope":"global","$longname":"actionMap","$kind":"property","id":8473,"neoClassName":"Neo.dialog.header.Toolbar"},{"comment":"/**\n         * You can define the action order and directly add custom actions. Leaving a name out leaves its control out.\n         * @example\n         * {\n         *     actions: [\n         *         'close',\n         *         'maximize',\n         *         {action: 'help', iconCls: 'far fa-circle-question'}\n         *     ]\n         * }\n         *\n         * @member {Object[]|String[]|null} actions=['maximize','close']\n         */","meta":{"filename":"Toolbar.mjs","lineno":40,"columnno":8,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-gpt-emmy/neomjs/pages/node_modules/neo.mjs/src/dialog/header","code":{},"srcPath":"src/dialog/header/Toolbar.mjs"},"description":"<p>You can define the action order and directly add custom actions. Leaving a name out leaves its control out.</p>\n","examples":["{\n    actions: [\n        'close',\n        'maximize',\n        {action: 'help', iconCls: 'far fa-circle-question'}\n    ]\n}"],"kind":"member","name":"actions","type":{"names":["Array.<Object>","Array.<String>","null"]},"defaultvalue":"['maximize','close']","longname":"actions","scope":"global","$longname":"actions","$kind":"property","id":8474,"neoClassName":"Neo.dialog.header.Toolbar"},{"comment":"/**\n         * @member {String|null} title=null\n         */","meta":{"filename":"Toolbar.mjs","lineno":44,"columnno":8,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-gpt-