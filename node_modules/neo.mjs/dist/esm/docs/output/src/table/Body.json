dy may be destroyed (`core.Base#destroy` rejects pending\n     * timeouts with `Neo.isDestroyed`) or the destination window may be gone (`worker.Base`\n     * rejects with `code: 'NEO_DEAD_PORT'`). Both are expected outcomes of a scroll into somewhere\n     * that no longer exists, not failures to report — and because a store load runs on every\n     * collection mutation, leaving either unhandled turns a ticking feed into one uncaught\n     * rejection per tick. Anything else IS a live failure, and this chain has no caller to\n     * propagate to, so the console is the honest terminal surface.\n     */","meta":{"range":[22152,23702],"filename":"Body.mjs","lineno":736,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-gpt-emmy/neomjs/pages/node_modules/neo.mjs/src/table","code":{"id":"astnode100067994","name":"TableBody#onStoreLoad","type":"MethodDefinition","paramnames":["data"]},"vars":{"":null},"srcPath":"src/table/Body.mjs"},"params":[{"type":{"names":["Object"]},"name":"data"},{"type":{"names":["Array.<Object>"]},"name":"data.items"},{"type":{"names":["Number"]},"optional":true,"name":"data.total"}],"access":"protected","name":"onStoreLoad","longname":"TableBody#onStoreLoad","kind":"function","memberof":"TableBody","scope":"instance","$longname":"TableBody#onStoreLoad","$kind":"method","id":13913,"neoClassName":"Neo.table.Body"},{"comment":"/**\n     * @summary Repaints an individual record edit, leaving batch repaints to {@link #onStoreRowsChange}.\n     * E.g. myRecord.foo = 'bar';\n     * @param {Object} opts\n     * @param {Object[]} opts.fields Each field object contains the keys: name, oldValue, value\n     * @param {Boolean} [opts.isBatch]\n     * @param {Neo.data.Model} opts.model The model instance of the changed record\n     * @param {Object} opts.record\n     */","meta":{"range":[24145,26184],"filename":"Body.mjs","lineno":796,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-gpt-emmy/neomjs/pages/node_modules/neo.mjs/src/table","cod