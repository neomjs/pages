ps.mjs","lineno":191,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100068941","name":"GoogleMaps#hideMarker","type":"MethodDefinition","paramnames":["data"]},"vars":{"":null}},"params":[{"type":{"names":["Object"]},"name":"data"},{"type":{"names":["String"]},"name":"data.id"},{"type":{"names":["String"]},"name":"data.mapId"}],"name":"hideMarker","longname":"GoogleMaps#hideMarker","kind":"function","memberof":"GoogleMaps","scope":"instance","$longname":"GoogleMaps#hideMarker","$kind":"method","id":9467,"neoClassName":"Neo.main.addon.GoogleMaps"},{"comment":"/**\n     * @summary Loads the Maps API and resolves only once `google.maps` is populated.\n     *\n     * The URL returns a BOOTSTRAP STUB, not the API. The script's `load` event fires when that stub\n     * finishes downloading, while `google.maps` appears only after the stub's own asynchronous fetch\n     * completes and calls the function named by `callback`. Awaiting `DomAccess.loadScript` alone\n     * therefore resolves too early, `Base#executeLoadFiles` marks the addon ready, and the first\n     * `create()` throws `ReferenceError: google is not defined`.\n     *\n     * So the awaited promise is settled by the callback, and `loadScript` contributes only its\n     * rejection path — a dead network still fails rather than hanging.\n     *\n     * One callback name for the window is enough, and does not need sharing machinery around it.\n     * `Main#registerAddon` keys its single-instance guard on `className`, so even a `WS/` workspace\n     * copy of this addon collapses onto the one instance; `Base#executeLoadFiles` then calls this\n     * once. Reaching a second waiter would take a `mainThreadAddons` list naming both this addon and\n     * a differently-named one that also loads Maps, which is not a configuration anyone writes.\n     * @protected\n     * @returns {Promise<void>}\n     */","meta":{"range":[7149,8103],"filename":"GoogleMaps.mjs","lineno":215,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main/addon","code":{"id":"astnode100068962","name":"GoogleMaps#loadFiles","type":"MethodDefinition","paramnames":[]},"vars":{"":null}},"summary":"Loads the Maps API and resolves only once `google.maps` is populated.\n\nThe URL returns a BOOTSTRAP STUB, not the API. The script's `load` event fires when that stub\nfinishes downloading, while `google.maps` appears only after the stub's own asynchronous fetch\ncompletes and calls the function named by `callback`. Awaiting `DomAccess.loadScript` alone\ntherefore resolves too early, `Base#executeLoadFiles` marks the addon ready, and the first\n`create()` throws `ReferenceError: google is not defined`.\n\nSo the awaited promise is settled by the callback, and `loadScript` contributes only its\nrejection path — a dead network still fails rather than hanging.\n\nOne callback name for the window is enough, and does not need sharing machinery around it.\n`Main#registerAddon` keys its single-instance guard on `className`, so even a `WS/` workspace\ncopy of this addon collapses onto the one instance; `Base#executeLoadFiles` then calls this\nonce. Reaching a second waiter would take a `mainThreadAddons` list naming both this addon and\na differently-named one that also loads Maps, which is not a configuration anyone writes.","access":"protected","returns":[{"type":{"names":["Promise.<void>"]}}],"name":"loadFiles","longname":"GoogleMaps#loadFiles","kind":"function","memberof":"GoogleMaps","scope":"instance","params":[],"async":true,"$longname":"GoogleMaps#loadFiles","$kind":"method","id":9468,"neoClassName":"Neo.main.addon.GoogleMaps"},{"comment":"/**\n     * @param {google.maps.Map} map\n     * @param {String} mapId\n     */","meta":{"range":[8190,8412],"filename":"GoogleMaps.mjs","lineno":247,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/no