":["FocusEvent"]},"name":"event"}],"name":"onFocusIn","longname":"DomEvents#onFocusIn","kind":"function","memberof":"DomEvents","scope":"instance","$longname":"DomEvents#onFocusIn","$kind":"method","id":9239,"neoClassName":"Neo.main.DomEvents"},{"comment":"/**\n     * A focusout raised while `Neo.main.DeltaUpdates` removes a node carries that node's id as\n     * `removedNodeId`, so the app worker can tell the leave of a removed mount from a leave to elsewhere.\n     * @param {FocusEvent} event\n     */","meta":{"range":[15810,16072],"filename":"DomEvents.mjs","lineno":533,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main","code":{"id":"astnode100058392","name":"DomEvents#onFocusOut","type":"MethodDefinition","paramnames":["event"]},"vars":{"":null}},"description":"<p>A focusout raised while <code>Neo.main.DeltaUpdates</code> removes a node carries that node&#39;s id as\n<code>removedNodeId</code>, so the app worker can tell the leave of a removed mount from a leave to elsewhere.</p>\n","params":[{"type":{"names":["FocusEvent"]},"name":"event"}],"name":"onFocusOut","longname":"DomEvents#onFocusOut","kind":"function","memberof":"DomEvents","scope":"instance","$longname":"DomEvents#onFocusOut","$kind":"method","id":9240,"neoClassName":"Neo.main.DomEvents"},{"comment":"/**\n     * Focus crossing into a nested document is invisible to the focus events this document forwards:\n     * the element losing focus fires `focusout` with no `relatedTarget`, the `<iframe>` element that\n     * now holds it fires no `focusin`, and only the window's `blur` says anything happened. Without a\n     * `focusin` the app worker's focus manager reads the `focusout` as a leave after its gap — a\n     * click into an iframe INSIDE a focus-holding subtree looks like leaving it. This forwards the\n     * frame element as the focus target, so the worker sees a move to the component that hosts the\n     * frame. `activeElement` settles after `blur`, hence the deferral; a blur that leaves the\n     * document altogether (another window) has no iframe at the active element and forwards nothing.\n     */","meta":{"range":[16896,17503],"filename":"DomEvents.mjs","lineno":554,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main","code":{"id":"astnode100058429","name":"DomEvents#onWindowBlur","type":"MethodDefinition","paramnames":[]},"vars":{"":null}},"description":"<p>Focus crossing into a nested document is invisible to the focus events this document forwards:\nthe element losing focus fires <code>focusout</code> with no <code>relatedTarget</code>, the <code>&lt;iframe&gt;</code> element that\nnow holds it fires no <code>focusin</code>, and only the window&#39;s <code>blur</code> says anything happened. Without a\n<code>focusin</code> the app worker&#39;s focus manager reads the <code>focusout</code> as a leave after its gap — a\nclick into an iframe INSIDE a focus-holding subtree looks like leaving it. This forwards the\nframe element as the focus target, so the worker sees a move to the component that hosts the\nframe. <code>activeElement</code> settles after <code>blur</code>, hence the deferral; a blur that leaves the\ndocument altogether (another window) has no iframe at the active element and forwards nothing.</p>\n","name":"onWindowBlur","longname":"DomEvents#onWindowBlur","kind":"function","memberof":"DomEvents","scope":"instance","params":[],"$longname":"DomEvents#onWindowBlur","$kind":"method","id":9241,"neoClassName":"Neo.main.DomEvents"},{"comment":"/**\n     * Tells the App Worker that this window regained focus, e.g. a user coming back from another application\n     */","meta":{"range":[17635,17812],"filename":"DomEvents.mjs","lineno":581,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/main","code":{"id":"astnode100058498","name":"DomEvents#onWindowFocus","type":"M