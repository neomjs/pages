ntPath","longname":"Component#getContentPath","kind":"function","memberof":"Component","scope":"instance","$longname":"Component#getContentPath","$kind":"method","id":2819,"neoClassName":"Neo.app.content.Component"},{"comment":"/**\n     * Updates the sections VM store and replaces ## with h2 tags\n     * @param {String} content\n     * @returns {String}\n     */","meta":{"range":[4608,4964],"filename":"Component.mjs","lineno":168,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/app/content","code":{"id":"astnode100042927","name":"Component#modifyMarkdown","type":"MethodDefinition","paramnames":["content"]},"vars":{"":null}},"description":"<p>Updates the sections VM store and replaces ## with h2 tags</p>\n","params":[{"type":{"names":["String"]},"name":"content"}],"returns":[{"type":{"names":["String"]}}],"name":"modifyMarkdown","longname":"Component#modifyMarkdown","kind":"function","memberof":"Component","scope":"instance","$longname":"Component#modifyMarkdown","$kind":"method","id":2820,"neoClassName":"Neo.app.content.Component"},{"comment":"/**\n     * @summary Resolves a relative Markdown target against the current record into a content id.\n     *\n     * Record ids are slash-separated and mirror the content tree, so the id doubles as the path the\n     * link is relative to: from `agentos/NeuralLink`, `../benefits/ArchitectureOverview.md` resolves to\n     * `benefits/ArchitectureOverview`. Written out rather than delegated to `path.posix` because this\n     * runs in the App worker, where node builtins are unavailable.\n     *\n     * @param {String} target a relative link target, fragment already stripped\n     * @returns {String|null} null when the target climbs out of the content root\n     * @protected\n     */","meta":{"range":[5655,6607],"filename":"Component.mjs","lineno":193,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/app/content","code":{"id":"astnode100042974","name":"Component#resolveContentId","type":"MethodDefinition","paramnames":["target"]},"vars":{"":null}},"summary":"Resolves a relative Markdown target against the current record into a content id.\n\nRecord ids are slash-separated and mirror the content tree, so the id doubles as the path the\nlink is relative to: from `agentos/NeuralLink`, `../benefits/ArchitectureOverview.md` resolves to\n`benefits/ArchitectureOverview`. Written out rather than delegated to `path.posix` because this\nruns in the App worker, where node builtins are unavailable.","params":[{"type":{"names":["String"]},"description":"<p>a relative link target, fragment already stripped</p>\n","name":"target"}],"returns":[{"type":{"names":["String","null"]},"description":"null when the target climbs out of the content root"}],"access":"protected","name":"resolveContentId","longname":"Component#resolveContentId","kind":"function","memberof":"Component","scope":"instance","$longname":"Component#resolveContentId","$kind":"method","id":2821,"neoClassName":"Neo.app.content.Component"},{"comment":"/**\n     * @summary Rewrites relative Markdown links onto {@link #contentRoute}, leaving every other href alone.\n     *\n     * A relative `.md` link is correct as authored — it is what a reader following the file on GitHub\n     * needs — but resolved by a browser it is relative to the DOCUMENT url, which in a routed app points\n     * outside the app entirely. Translating it here means one authored form serves both readers, instead\n     * of the author having to choose which one to break.\n     *\n     * Only relative `.md` targets are touched. Absolute urls, in-page anchors and root-absolute paths are\n     * returned untouched, and so are links to source files: no content route exists for those, and\n     * inventing one would turn a visibly broken link into a silently wrong destination.\n     *\n     * @param {String} html\n     * @returns {String}\n     */","meta":{"range":[7481,9529],"filename":"Component.mjs","lineno":234,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/app/content","code":{"id":"astnode100043061","name":"Component#rewriteLinks","type":"MethodDefinition","paramnames":["html"]},"vars":{"":null}},"summary":"Rewrites relative Markdown links onto {@link #contentRoute}, leaving every other href alone.\n\nA relative `.md` link is correct as authored — it is what a reader following the file on GitHub\nneeds — but resolved by a browser it is relative to the DOCUMENT url, which in a routed app points\noutside the app entirely. Translating it here means one authored form serves both readers, instead\nof the author having to choose which one to break.\n\nOnly relative `.md` targets are touched. Absolute urls, in-page anchors and root-absolute paths are\nreturned untouched, and so are links to source files: no content route exists for those, and\ninventing one would turn a visibly broken link into a silently wrong destination.","params":[{"type":{"names":["String"]},"name":"html"}],"returns":[{"type":{"names":["String"]}}],"name":"rewriteLinks","longname":"Component#rewriteLinks","kind":"function","memberof":"Component","scope":"instance","$longname":"Component#rewriteLinks","$kind":"method","id":2822,"neoClassName":"Neo.app.content.Component"},{"comment":"/**\n     * @param {String} tag\n     * @param {String} text\n     * @param {Number} index\n     * @returns {String}\n     */","meta":{"range":[9660,10089],"filename":"Component.mjs","lineno":278,"columnno":4,"path":"/Users/tobiasuhlig/.neo-ai/agents/neo-opus-grace/neomjs/pages/node_modules/neo.mjs/src/app/content","code":{"id":"astnode100043153","name":"Component#onHeadline","type":"MethodDefinition","paramnames":["tag","text","index"]},"vars":{"":null}},"params":[{"type":{"names":["String"]},"name":"tag"},{"type":{"names":["String"]},"name":"text"},{"type":{"names":["Number"]},"name":"index"}],"returns":[{"type":